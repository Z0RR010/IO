@page "/"
@using System.Globalization
@using Microsoft.Extensions.Localization
@rendermode InteractiveServer
@inject IStringLocalizer<Home> Loc
@inject NavigationManager nav
<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<AuthorizeView>
	<NotAuthorized>
		<h5>nie ma autoryzacji</h5>
	</NotAuthorized>
</AuthorizeView>

<AuthorizeView Roles="Volunteer">
	<Authorized>
		<h4>witaj darczynco</h4>
		<p2>@name</p2>
	</Authorized>
</AuthorizeView>

<AuthorizeView Roles="Charity">
	<Authorized>
		<h4>witaj organizacjo charytatywna</h4>
		<p2>@name</p2>
	</Authorized>
</AuthorizeView>

<h2 class="validation-message">This is not a real site</h2>
<h2 class="validation-message">You should not enter any of your real information on this site as we do not guarantee information entered will be safe</h2>
<p>This site is created as a college project</p>

<footer class="footer">
    <button @onclick="Polish" class="lang">Polski</button>
    <button @onclick="English" class="lang">English</button>
</footer>

@code
{
	[CascadingParameter]
	private Task<AuthenticationState> authenticationStateTask{ get; set; }

	public string name;

	private async Task displayInfo()
	{
		var authenticationState = await authenticationStateTask;
		var message = authenticationState.User.Identity.Name;

	}

    private async Task English()
    {
        String newUri = nav.Uri;
        String oldUri = nav.Uri;
        if (newUri.Contains("?ui-culture=pl"))
        {
            newUri = newUri.Replace("?ui-culture=pl", "?ui-culture=en-US");
        }
        if (!newUri.Contains("?ui-culture=en-US"))
        {
            newUri += "?ui-culture=en-US";
        }
        nav.NavigateTo(newUri,true);
    }

    private async Task Polish()
    {
        String newUri = nav.Uri;
        if (newUri.Contains("?ui-culture=en-US"))
        {
            newUri = newUri.Replace("?ui-culture=en-US", "?ui-culture=pl");
        }
        if (!newUri.Contains("?ui-culture=pl"))
        {
            newUri += "?ui-culture=pl";
        }
        nav.NavigateTo(newUri,true);
    }

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		var authenticationState = await authenticationStateTask;
		var message = authenticationState.User.Identity.Name;
		name = message;
	}
}