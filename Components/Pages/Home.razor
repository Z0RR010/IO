@page "/"
@using System.Globalization
@using IO.Modules.ResourceManager
@using Microsoft.Extensions.Localization
@using IO.Modules.Security
@rendermode InteractiveServer
@inject IStringLocalizer<Home> Loc
@inject NavigationManager nav
<PageTitle>@Loc["Main"]</PageTitle>

<h1>
    @Loc["Hello"]
</h1>

<AuthorizeView>
    <NotAuthorized>
        <h5>@Loc["NoAuth"]</h5>
        <h2 class="validation-message">@Loc["NotReal"]</h2>
    </NotAuthorized>
</AuthorizeView>

<AuthorizeView Roles="Volunteer">
    <Authorized>
        <h4>@Loc["Vol"]</h4>
        <p2>@name</p2>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Charity">
    <Authorized>
        <h4>@Loc["Char"]</h4>
        <p2>@name</p2>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Admin">
    <Authorized>
        <h4>@Loc["Adm"]</h4>
        <p2>@name</p2>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Donor">
    <Authorized>
        <h4>@Loc["Don"]</h4>
        <p2>@name</p2>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Authority">
    <Authorized>
        <h4>@Loc["Aut"]</h4>
        <p2>@name</p2>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Affected">
    <Authorized>
        @if (isVerified)
        {
            <h4>@Loc["Aff"]</h4>
            <p2>@name</p2>
        }
        @if (!isVerified)
        {
        <h4>@Loc["NoV"]</h4>
        <p2>@name</p2>
        }

    </Authorized>
</AuthorizeView>


<h2 class="validation-message">@Loc["NoReal"]</h2>
<p>@Loc["Proj"]</p>

<footer class="footer">
    <button @onclick="Polish" class="lang">Polski</button>
    <button @onclick="English" class="lang">English</button>
</footer>

@code
{
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask{ get; set; }

    public string name;
    public bool isVerified = false;

    private async Task displayInfo()
    {
        var authenticationState = await authenticationStateTask;
        var message = authenticationState.User.Identity.Name;

    }

    private async Task English()
    {
        String newUri = nav.Uri;
        String oldUri = nav.Uri;
        if (newUri.Contains("?ui-culture=pl"))
        {
            newUri = newUri.Replace("?ui-culture=pl", "?ui-culture=en-US");
        }
        if (!newUri.Contains("?ui-culture=en-US"))
        {
            newUri += "?ui-culture=en-US";
        }
        nav.NavigateTo(newUri,true);
    }

    private async Task Polish()
    {
        String newUri = nav.Uri;
        if (newUri.Contains("?ui-culture=en-US"))
        {
            newUri = newUri.Replace("?ui-culture=en-US", "?ui-culture=pl");
        }
        if (!newUri.Contains("?ui-culture=pl"))
        {
            newUri += "?ui-culture=pl";
        }
        nav.NavigateTo(newUri,true);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authenticationState = await authenticationStateTask;
        var message = authenticationState.User.Identity.Name;
        name = message;
        UserExecuter executor = new UserExecuter();
        if (name != null)
        {
            BasicUser user = executor.GetBasicUser(name.Trim());
            isVerified = user.IsVerified;
        }
        
	}
}