@page "/Communication/Reports"
@using System.IO
@using System.Text
@using IO.Modules.Communication
@using System.Globalization
@using IO.Modules.Security
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Conversation> Loc
@inject RaportManager RaportService
@inject SessionService ses

<div class="container my-5">
    @if (authorized)
    {
        <h2 class="text-black">@Loc["Communicator Report Viewer & Downloader"]</h2>

        <!-- Scrollable Report Display -->
        <div class="scrollable-report mb-4">
            <pre>@reportContent</pre>
        </div>

        <!-- Download Section -->
        <div class="text-center">
            <label for="daysBefore" class="text-black">@Loc["Days Before:"]</label>
            <input type="number" id="daysBefore" @bind="daysBefore" min="0" class="form-control-inline" />
            <a class="btn btn-primary mt-2" href="@GetDownloadLink()" download>@Loc["Download Report"]</a>
        </div>
    }
    else
    {
        <p class="text-center text-danger">@Loc["You do not have permission to view this content."]</p>
    }
</div>

@code {
    private string reportContent;
    private int daysBefore = 0;
    bool authorized = false;

    protected override void OnInitialized()
    {
        // Fetch the report content from RaportManager
        reportContent = RaportService.activeReport ?? "No report available.";
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await ses.GetUserNameAsync();
        if (user != null && user == "skph@interia.pl")
        {
            authorized = true;
            reportContent = RaportService.activeReport ?? "No report available.";
        }
    }

    private string GetDownloadLink()
    {
        return $"/api/Report/download?daysBefore={daysBefore}";
    }
}
<style>
    .container {
        max-width: 700px;
        margin: 0 auto;
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .scrollable-report {
        max-height: 400px; /* Set a fixed height */
        overflow-y: auto; /* Enable vertical scrolling */
        padding: 10px;
        background-color: #f7f7f7;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-family: monospace;
        font-size: 0.95rem;
        color: #333;
        white-space: pre-wrap; /* Preserve whitespace for formatting */
    }

    .form-control-inline {
        display: inline-block;
        width: auto;
        vertical-align: middle;
        margin: 0 10px;
    }

    .btn {
        padding: 10px 20px;
        font-size: 0.9rem;
    }

    .text-black {
        color: black;
    }
</style>