@page "/requests/details/{Id:int}"

<h3>Request Details</h3>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (request == null)
{
    <p><em>Request not found.</em></p>
}
else
{
    <div>
        <h4>@request.Title</h4>
        <p>@request.Description</p>
        <p>Status: @request.Status</p>
        <p>Created At: @request.CreatedAt</p>
        <p>Updated At: @request.DateUpdated</p>
        <p>User: @request.User </p>
        <p>Address: @request.Address.Street, @request.Address.City, @request.Address.StreetNumber, @request.Address.Apartment, @request.Address.ZipCode</p>
        <p>Resources Required: @string.Join(", ", request.ResourcesRequired.Select(r => $"{r.Name} (x{r.Amount})"))</p>
        <p>Is Verified: @request.IsVerified</p>
    </div>
}

<style>
    h3 {
        font-size: 1.5rem;
        color: #2c3e50; /* Sta³y kolor nag³ówka */
        margin-bottom: 1rem;
    }

    h4 {
        font-size: 1.3rem;
        color: #34495e; /* Sta³y kolor tytu³u sekcji */
        margin-bottom: 0.5rem;
    }

    .container {
        max-width: 800px;
        margin: 20px auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #ffffff; /* Bia³e t³o, niezale¿ne od motywu */
        color: #2c3e50; /* Sta³y kolor tekstu */
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

        /* Tekst w paragrafach */
        .container p {
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 0.8rem;
            color: #2c3e50; /* Sta³y kolor tekstu */
        }

    /* Stylowanie dla sekcji "loading" lub "not found" */
    em {
        color: #7f8c8d; /* Neutralny szary kolor */
        font-style: italic;
    }

    /* Podkreœlenie adresu */
    .container p:nth-child(6) {
        font-weight: bold;
        font-style: italic;
        color: #34495e;
    }

    /* Lista zasobów */
    .resources-required {
        font-size: 1rem;
        color: #2c3e50; /* Sta³y kolor tekstu */
        list-style-type: disc;
        margin-left: 20px;
    }

    /* Dodanie kontrastu dla lepszej czytelnoœci */
    .container p strong {
        color: #e74c3c; /* Akcentowany kolor dla wa¿nych informacji */
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private IO.Modules.ResourceManager.RequestManager requestManager = new IO.Modules.ResourceManager.RequestManager();
    private RequestModule.Request request;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            request = await requestManager.GetRequestById(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading request details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}