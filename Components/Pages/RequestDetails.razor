@page "/requests/details/{Id:int}"

<h3>Request Details</h3>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (request == null)
{
    <p><em>Request not found.</em></p>
}
else
{
    <div>
        <h4>@request.Title</h4>
        <p>@request.Description</p>
        <p>Status: @request.Status</p>
        <p>Created At: @request.CreatedAt</p>
        <p>Updated At: @request.DateUpdated</p>
        <p>User: @request.User </p>
        <p>Address: @request.Address.Street, @request.Address.City, @request.Address.StreetNumber, @request.Address.Apartment, @request.Address.ZipCode</p>
        <p>Resources Required: @string.Join(", ", request.ResourcesRequired.Select(r => $"{r.Name} (x{r.Amount})"))</p>
        <p>Is Verified: @request.IsVerified</p>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private IO.Modules.ResourceManager.RequestManager requestManager = new IO.Modules.ResourceManager.RequestManager();
    private RequestModule.Request request;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            request = await requestManager.GetRequestById(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading request details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}