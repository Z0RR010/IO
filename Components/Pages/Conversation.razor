@page "/communication/conversation"
@rendermode InteractiveServer
@using System.Globalization
@inject IStringLocalizer<Conversation> Loc
@using IO.Modules.Communication
@using IO.Modules.Security
@using Microsoft.Extensions.Localization
@inject Communicator CommunicatorService
@inject SessionService ses
@inject NavigationManager nav

<div class="container my-4">

    <!-- User Email Input -->
    <div class="mb-4">
        <label for="userEmailToRead" class="form-label text-black">@Loc["User Email"]</label>
        <input type="email" id="userEmailToRead" class="form-control" @bind="newChatUser" placeholder=@Loc["User Email"] />
        <button class="btn btn-primary mt-2" @onclick="beginChatWithSomeone">@Loc["Start Conversation"]</button>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-2">@errorMessage</div>
        }
    </div>

    <!-- Search Input -->
    <div class="mb-4">
        <label for="searchTerm" class="form-label text-black">@Loc["Search Conversation"]</label>
        <input type="text" id="searchTerm" class="form-control" @bind="searchTerm" placeholder=@Loc["Search Conversation"] @oninput="FilterChats" />
    </div>

    <!-- Chat List -->
    <h3 class="text-black">@Loc["Conversation"]</h3>
    @if (filteredChats.Any())
    {
        <div class="list-group">
            @foreach (var chat in filteredChats)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>
                            <strong>@Loc["Users"]</strong>
                            <ul class="mb-0">
                                @foreach (var participant in chat.Emails)
                                {
                                    <li>@participant</li>
                                }
                            </ul>
                        </span>
                        <form method="get" action="/Communication/Conversation/ChatMan">
                            <input type="hidden" name="chatId" value="@chat.ChatId" />
                            <button type="submit" class="btn btn-primary">
                                @Loc["Open Conversation"]
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">@Loc["No Conversations"]</p>
    }
</div>
<footer class="footer">
        <button @onclick="Polish" class="lang">Polski</button>
        <button @onclick="English" class="lang">English</button>
    </footer>
@code {
    private string userEmailToRead;
    private string newChatUser;
    private string searchTerm;
    private string errorMessage;
    private List<Chat> userChats = new();
    private List<Chat> filteredChats = new();

    protected override async Task OnInitializedAsync()
    {
        userEmailToRead = await ses.GetUserNameAsync();
        if (userEmailToRead == "Anonymous")
        {
            nav.NavigateTo("",true);
        }
        userChats = CommunicatorService.GetUserChats(userEmailToRead);
        FilterChats();
    }

    // Fetch user's chats
    private void GetUserChats()
    {
        if (!string.IsNullOrWhiteSpace(userEmailToRead))
        {
            userChats = CommunicatorService.GetUserChats(userEmailToRead);
            FilterChats();
        }
    }

    // Initialize a new chat with a user
    private void beginChatWithSomeone()
    {
        string[] usersToAdd = { userEmailToRead, newChatUser };
        if (!string.IsNullOrWhiteSpace(newChatUser) && newChatUser != userEmailToRead)
        {
            bool chatCreated = CommunicatorService.CreateChat(Permission.System, usersToAdd);
            if (chatCreated)
            {
                errorMessage = string.Empty; // Clear any previous error message
                GetUserChats(); // Refresh user chats
            }
            else
            {
                errorMessage = Loc["The user email does not exist."];
            }
        }
    }

    // Filter chats based on search term
    private void FilterChats()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredChats = userChats;
        }
        else
        {
            filteredChats = userChats.Where(chat => chat.Emails.Any(email => email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))).ToList();
        }
    }

    private async Task English()
        {
            String newUri = nav.Uri;
            String oldUri = nav.Uri;
            if (newUri.Contains("?ui-culture=pl"))
            {
                newUri = newUri.Replace("?ui-culture=pl", "?ui-culture=en-US");
            }
            if (!newUri.Contains("?ui-culture=en-US"))
            {
                newUri += "?ui-culture=en-US";
            }
            nav.NavigateTo(newUri, true);
        }

        private async Task Polish()
        {
            String newUri = nav.Uri;
            if (newUri.Contains("?ui-culture=en-US"))
            {
                newUri = newUri.Replace("?ui-culture=en-US", "?ui-culture=pl");
            }
            if (!newUri.Contains("?ui-culture=pl"))
            {
                newUri += "?ui-culture=pl";
            }
            nav.NavigateTo(newUri, true);
        }
}
<style>
    .container {
        max-width: 700px;
        margin: 0 auto;
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .scrollable-report {
        max-height: 400px; /* Set a fixed height */
        overflow-y: auto; /* Enable vertical scrolling */
        padding: 10px;
        background-color: #f7f7f7;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-family: monospace;
        font-size: 0.95rem;
        color: #333;
        white-space: pre-wrap; /* Preserve whitespace for formatting */
    }

    .form-control-inline {
        display: inline-block;
        width: auto;
        vertical-align: middle;
        margin: 0 10px;
    }

    .btn {
        padding: 10px 20px;
        font-size: 0.9rem;
    }

    .text-black {
        color: black;
    }
</style>