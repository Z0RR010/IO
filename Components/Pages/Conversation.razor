@page "/communication/conversation"
@rendermode InteractiveServer

@using IO.Modules.Communication
@inject Communicator CommunicatorService

<div class="container my-4">
    <h2 class="text-center">Odczytywanie wiadomości</h2>

    <!-- User Email Input -->
    <div class="mb-4">
        <label for="userEmailToRead" class="form-label">E-mail użytkownika:</label>
        <input type="email" id="userEmailToRead" class="form-control" @bind="newChatUser" placeholder="Wprowadź e-mail użytkownika..." />
        <button class="btn btn-primary mt-2" @onclick="beginChatWithSomeone">Rozpocznij nową konwersacje</button>
    </div>

    <!-- Chat List -->
    <h3 class="mt-5">Konwersacje użytkownika:</h3>
    @if (userChats.Any())
    {
        <div class="list-group">
            @foreach (var chat in userChats)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>
                            <strong>Użytkownicy:</strong>
                            <ul class="mb-0">
                                @foreach (var participant in chat.Emails)
                                {
                                    <li>@participant</li>
                                }
                            </ul>
                        </span>
                        <form method="get" action="/Communication/Conversation/ChatMan">
                            <input type="hidden" name="chatId" value="@chat.ChatId" />
                            <button type="submit" class="btn btn-primary">
                                Open Conversation
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Brak konwersacji dla podanego użytkownika.</p>
    }

   
</div>

@code {
    private string userEmailToRead = "matiziom72@gmail.com";
    private string newChatUser;
    private List<Chat> userChats = new();

    
    // Fetch messages for the selected chat
    protected override void OnInitialized()
    {
        userChats = CommunicatorService.GetUserChats(userEmailToRead);
    }

    // Fetch user's chats
    private void GetUserChats()
    {
        if (!string.IsNullOrWhiteSpace(userEmailToRead))
        {
            userChats = CommunicatorService.GetUserChats(userEmailToRead);
        }
    }

    private void beginChatWithSomeone()
    {
        string[] usersToAdd = { userEmailToRead, newChatUser };
        if (!string.IsNullOrWhiteSpace(newChatUser) && newChatUser != userEmailToRead)
        {
            CommunicatorService.CreateChat(Permission.System, usersToAdd);
        }
        userChats = CommunicatorService.GetUserChats(userEmailToRead);
    }
    
}