@page "/volunteer"
@rendermode InteractiveServer

<PageTitle>Volunteer</PageTitle>

<h1>Volunteer</h1>
<p role="status">Volunteers: @volunteerCount  Organisations: @organisationCount</p>

<button class="btn btn-primary" @onclick="volunteerApplication">Single Volunteer Application</button>
<button class="btn btn-primary" @onclick="organisationApplication">Organisation Application</button>

<button class="btn btn-primary" @onclick="save">Save</button>

<button class="btn btn-primary" @onclick="load">Load</button>

@if (whichForm == 1)
{
    <h1>Volunteer Application</h1>

    <div>

        <p>First Name: </p>
        <input type="text" @bind="firstName" placeholder="Enter first name" class="form-control mt-2" />

        <p>Last Name: </p>
        <input type="text" @bind="lastName" placeholder="Enter last name" class="form-control mt-2" />

        <p>Email: </p>
        <input type="email" @bind="email" placeholder="Enter email" class="form-control mt-2" />

        <p>Gender: </p>
        <select @bind="gender" class="form-select mt-2">
            <option value="">Select Gender</option>
            @foreach (var genderOption in Enum.GetValues(typeof(IO.Modules.Volunteer.Gender)).Cast<IO.Modules.Volunteer.Gender>())
            {
                <option value="@genderOption">@genderOption</option>
            }
        </select>

        <p>Phone Number: </p>
        <input type="text" @bind="PhoneNumberString" placeholder="Enter phone number" class="form-control mt-2" />

        <p>Address: </p>
        <input type="text" @bind="address" placeholder="Enter address" class="form-control mt-2" />

        <p>Experience: </p>
        <textarea @bind="experience" placeholder="Enter experience" class="form-control mt-2"></textarea>

        <p>Additional Info: </p>
        <textarea @bind="additionalInfo" placeholder="Enter additional information" class="form-control mt-2"></textarea>

        <p>Skills: </p>
        <textarea @bind="skills" placeholder="Enter skills" class="form-control mt-2"></textarea>

        <p>Availability: </p>
        <div class="d-flex gap-2 align-items-center">
            <input type="date" @bind="newAvailabilityDate" class="form-control" />
            <button class="btn btn-success" @onclick="AddAvailabilityDate">Add</button>
        </div>
        <ul class="list-group mt-2">
            @foreach (var date in availability)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @date.ToShortDateString()
                    <button class="btn btn-danger btn-sm" @onclick="() => RemoveAvailabilityDate(date)">Remove</button>
                </li>
            }
        </ul>

        <p>Organisation: </p>
        <select @bind="selectedOrganisationID" class="form-select mt-2">
            <option value="">Select an organisation</option>
            @foreach (var org in organisationList)
            {
                <option value="@org.OrganisationID">@org.OrganisationName</option>
            }
        </select>

        <p>Selected Organisation: @selectedOrganisationName</p>
        <p> </p>
        <button class="btn btn-primary" @onclick="createVolunteer">Submit</button>

    </div>
}

@if (whichForm == 2)
{
    <h1>Organisation Application</h1>

    <div>


        <p>Organisation Name: </p>
        <input type="text" @bind="organisationName" placeholder="Enter name" class="form-control mt-2" />


        <p>Phone Number: </p>
        <input type="text" @bind="PhoneNumberString" placeholder="Enter phone number" class="form-control mt-2" />

        <p>Address: </p>
        <input type="text" @bind="address" placeholder="Enter address" class="form-control mt-2" />
        <p> </p>

        <button class="btn btn-primary" @onclick="createOrganisation">Submit</button>


    </div>
}

@code {
    private int whichForm = 0;
    private int volunteerCount = 0;
    private int organisationCount = 0;
    private int volunteerID = 0;

    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string email = string.Empty;
    private IO.Modules.Volunteer.Gender gender = IO.Modules.Volunteer.Gender.Female;
    private char[] phoneNumber = new char[0];
    private string address = string.Empty;
    private string experience = string.Empty;
    private string additionalInfo = string.Empty;
    private string skills = string.Empty;

    private string organisationName = string.Empty;

    private List<DateTime> availability = new List<DateTime>();
    private DateTime newAvailabilityDate = DateTime.Today;

    private List<IO.Modules.Volunteer.Organisation> organisationList = new List<IO.Modules.Volunteer.Organisation>();
    private int? selectedOrganisationID;

    private string selectedOrganisationName =>
        organisationList.FirstOrDefault(o => o.OrganisationID == selectedOrganisationID)?.OrganisationName ?? "None";

    IO.Modules.Volunteer.VolunteerManager volunteerManager = new IO.Modules.Volunteer.VolunteerManager();

    protected override async Task OnInitializedAsync()
    {
        load();
    }

    private void volunteerApplication()
    {
        whichForm = 1;
        phoneNumber = new char[0];
        address = string.Empty;
    }
    private void organisationApplication()
    {
        whichForm = 2;
        phoneNumber = new char[0];
        address = string.Empty;
    }
    public string PhoneNumberString
    {
        get => new string(phoneNumber);
        set => phoneNumber = value.ToCharArray();
    }

    private void AddAvailabilityDate()
    {
        if (!availability.Contains(newAvailabilityDate))
        {
            availability.Add(newAvailabilityDate);
        }
    }

    private void RemoveAvailabilityDate(DateTime date)
    {
        availability.Remove(date);
    }

    private void createVolunteer()
    {
        IO.Modules.Volunteer.Volunteer vol = new IO.Modules.Volunteer.Volunteer(
            firstName,
            lastName,
            email,
            gender,
            phoneNumber,
            address,
            experience,
            additionalInfo,
            skills,
            availability,
            organisationList.FirstOrDefault(o => o.OrganisationID == selectedOrganisationID)
        );

        volunteerManager.AddVolunteer(vol);
    }

    private void createOrganisation()
    {
        IO.Modules.Volunteer.Organisation org = new IO.Modules.Volunteer.Organisation(
            organisationName,
            phoneNumber,
            address
        );

        volunteerManager.AddOrganisation(org);
    }

    private void save()
    {
        string filePath = "volunteersData";
        using (StreamWriter writer = new StreamWriter(filePath, append: false))
        {
            writer.Write(volunteerManager.SaveManagerToFile());
        }
        volunteerCount = volunteerManager.VolunteerCount;
        organisationCount = volunteerManager.OrganisationCount;
    }

    private void load()
    {
        string filePath = "volunteersData";
        volunteerManager.LoadManagerFromFile(filePath);
        volunteerCount = volunteerManager.VolunteerCount;
        organisationCount = volunteerManager.OrganisationCount;
        organisationList = volunteerManager.OrganisationList;
    }
}