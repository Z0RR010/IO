@page "/verification"
@rendermode InteractiveServer
@using IO.Modules.Security
@using IO.Modules.ResourceManager
@using Microsoft.Extensions.Localization
@inject NavigationManager nav
@inject IStringLocalizer<Verification> Loc

<title>@Loc["Verify"]</title>
<h1>@Loc["Verify"]</h1>
<table class="table">
    <thead>
            <tr>
                <th>@Loc["Name"]</th>
                <th>@Loc["Surname"]</th>
                <th>@Loc["Address"]</th>
                <th>Pesel</th>
                <th></th>
            </tr>
        </thead>
        <tbody>

        
    @foreach (var user in users)
    {
        <tr>
            <td>
                @user.Name
            </td>
            <td>
                @user.Surname
            </td>
            <td>
                @user.Address
            </td>
            <td>
                @user.Pesel
            </td>
            
            
            <button class="btn-primary" @onclick="() => Verify(user.Email)">@Loc["Ver"]</button>
        </tr>
    }
    </tbody>
</table>





@code
{
    List<BasicUser> users = new List<BasicUser>();
    List<String> emails = new List<String>();
    UserExecuter userX = new UserExecuter();

	protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        string getAllMails = "SELECT email FROM users";
        string result = userX.CustomQuery(getAllMails);
        List<string> res = result.Split('\n').ToList();
        List<BasicUser> allUsers = new List<BasicUser>();
        foreach (var s in res)
        {
            allUsers.Add(userX.GetBasicUser(s.Trim()));
        }
        allUsers = allUsers.Where(x => x != null).ToList();
        users = allUsers.Where(u => u.Role == "Affected" && !u.IsVerified).ToList();
        foreach (var u in users)
        {
            emails.Add(u.Email);
        }
    }
async Task Verify(string email)
{
    userX.VerifyUser(email);    
    nav.Refresh(true);
}



    @* bool NotVerfiedPredicate(BasicUser user)
    {
        Console.WriteLine(user.Role);
        Console.WriteLine(user.IsVerified);
    } *@


}

