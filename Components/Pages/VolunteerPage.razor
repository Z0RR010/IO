    private void AddField()
    {
        fieldValues.Add("");
    }

    private void RemoveField(int i)
    {
        if (fieldValues.Count > 1)
        {
            fieldValues.RemoveAt(i);
        }
    }

    private void MoveFieldUp(int i)
    {
        if (i > 0)
        {
            (fieldValues[i], fieldValues[i - 1]) = (fieldValues[i - 1], fieldValues[i]);
        }
    }

    private void MoveFieldDown(int i)
    {
        if (i < fieldValues.Count - 1)
        {
            (fieldValues[i], fieldValues[i + 1]) = (fieldValues[i + 1], fieldValues[i]);
        }
    }

    private async void ConfirmFields()
    {
        Route rt;
        Coordinates coordinates = await Geolocation.GetUserLocation();
        if (coordinates == null)
        {
            rt = new Route(new AddressStringWrapper(globalAddress), map01.GetLocation());
        }
        else
        {
            rt = new Route(new CoordinatesWrapper(coordinates), map01.GetLocation());
        }
        foreach (string location in fieldValues)
        {
            if (!string.IsNullOrEmpty(location))
            {
                rt.AddRouteLocation(new AddressStringWrapper(location));
            }

        }
        map01.SetRoute(rt);
        await map01.DrawMap();
    }

