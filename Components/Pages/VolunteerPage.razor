@if (whichForm == 16)
{
    <h1>Task List</h1>
    <ul class="list-group">
        @foreach (var task in taskList)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center"
                @onclick="() => ShowTaskDetails(task)">
                @task.Description
                <button class="btn btn-info btn-sm">Details</button>
            </li>
        }
    </ul>

    @if (selectedTask != null && selectedTask.Description != null)
    {
        <div class="mt-3 p-3 border rounded">
            <h3>Task Details</h3>
            <p><strong>Description:</strong> @selectedTask.Description</p>
            <p><strong>Address:</strong> @selectedTask.Address</p>
            <p><strong>Availability:</strong></p>
            <ul>
                @foreach (var date in selectedTask.Availability)
                {
                    <li>@date.ToString("yyyy-MM-dd")</li>
                }
            </ul>
        </div>
    }
    <button class="btn btn-primary" @onclick="() => ChangeForm(4)">Back</button>

}