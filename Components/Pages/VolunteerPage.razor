@if (whichForm == 7)
{
    <h1>Hello @selectedVolunteer.FirstName</h1>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(1)">Create Task</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(2)">Your Tasks</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(3)">Profile Information</button>


    @if (selectedOption == 1)
    {
        <h1>Available Tasks</h1>
        <ul class="list-group">
            @foreach (var volunteerTask in selectedVolunteer.Organisation.VolunteerTaskList)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center"
                    @onclick="() => ShowTaskDetails(volunteerTask)">
                    <div>
                        <strong>@volunteerTask.Description</strong> - Status: @volunteerTask.TaskStatus
                    </div>
                    <button class="btn btn-info btn-sm">Details</button>
                </li>
            }
        </ul>

        @if (selectedTask != null && selectedTask.Description != null)
        {
            <div class="mt-3 p-3 border rounded">
                <h3>VolunteerTask Details</h3>
                <p><strong>Description:</strong> @selectedTask.Description</p>
                <p><strong>Address:</strong> @selectedTask.Address</p>
                <p><strong>EndDate:</strong></p>

                <ul>
                    @foreach (var date in selectedTask.EndDate)
                    {
                        <li>@date.ToString("yyyy-MM-dd")</li>
                    }
                </ul>

                <button class="btn btn-primary" @onclick="() => AssignTask(0)">Assign VolunteerTask</button>
            </div>
        }
    }

    @if(selectedOption == 2)
    {
        <h1>Your Tasks</h1>
        <ul class="list-group">
            @foreach (var volunteerTask in selectedVolunteer.VolunteerTaskList)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center"
                    @onclick="() => ShowTaskDetails(volunteerTask)">
                    <div>
                        <strong>@volunteerTask.Description</strong> - Status: @volunteerTask.TaskStatus
                    </div>
                    <button class="btn btn-info btn-sm">Details</button>
                </li>
            }
        </ul>

        @if (selectedTask != null && selectedTask.Description != null)
        {
            <div class="mt-3 p-3 border rounded">
                <h3>VolunteerTask Details</h3>
                <p><strong>Description:</strong> @selectedTask.Description</p>
                <p><strong>Address:</strong> @selectedTask.Address</p>
                <p><strong>EndDate:</strong></p>

                <ul>
                    @foreach (var date in selectedTask.EndDate)
                    {
                        <li>@date.ToString("yyyy-MM-dd")</li>
                    }
                </ul>
            </div>
        }

    }
    @if(selectedOption == 3)
    {
        <h1>Profile Information</h1>
        <p>First Name: <input type="text" value="@selectedVolunteer.FirstName" readonly class="form-control" /></p>
        <p>Last Name: <input type="text" value="@selectedVolunteer.LastName" readonly class="form-control" /></p>
        <p>Email: <input type="text" value="@selectedVolunteer.Email" readonly class="form-control" /></p>
        <p>Phone Number: <input type="text" value="@PhoneNumberToString(selectedVolunteer.PhoneNumber)" readonly class="form-control" /></p>
        <p>Address: <input type="text" value="@selectedVolunteer.Address" readonly class="form-control" /></p>
        <p>Organisation: <input type="text" value="@selectedVolunteer.Organisation.OrganisationName" readonly class="form-control" /></p>

    }

    <button class="btn btn-primary" @onclick="() => ChangeForm(0)">Back</button>
}


@if (whichForm == 8)
{
    <h1>Hello @selectedOrganisation.OrganisationName</h1>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(1)">Create Task</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(2)">Your Tasks</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(3)">Your Volunteers</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(4)">Edit Your Profile</button>

    @if (selectedOption == 1)
    {
        <h1>Create Task</h1>

        <div>

            <p>Description: </p>
            <input type="text" @bind="description" placeholder="Description" class="form-control mt-2" />

            <p>Address: </p>
            <input type="text" @bind="address" placeholder="Enter address" class="form-control mt-2" />
            <p> </p>

            <p>EndDate: </p>
            <div class="d-flex gap-2 align-items-center">
                <input type="date" @bind="newAvailabilityDate" class="form-control" />
                <button class="btn btn-success" @onclick="AddAvailabilityDate">Add</button>
            </div>
            <ul class="list-group mt-2">
                @foreach (var date in endDate)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @date.ToShortDateString()
                        <button class="btn btn-danger btn-sm" @onclick="() => RemoveAvailabilityDate(date)">Remove</button>
                    </li>
                }
            </ul>

            <button class="btn btn-primary" @onclick="CreateTask">Submit</button>


        </div>
    }

    @if (selectedOption == 2)
    {
        <h1>Your Tasks</h1>
        <ul class="list-group">
            @foreach (var volunteerTask in selectedOrganisation.VolunteerTaskList)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center"
                    @onclick="() => ShowTaskDetails(volunteerTask)">
                    <div>
                        <strong>@volunteerTask.Description</strong> - Status: @volunteerTask.TaskStatus
                    </div>
                    <button class="btn btn-info btn-sm">Details</button>
                </li>
            }
        </ul>

        @if (selectedTask != null && selectedTask.Description != null)
        {
            <div class="mt-3 p-3 border rounded">
                <h3>VolunteerTask Details</h3>
                <p><strong>Description:</strong> @selectedTask.Description</p>
                <p><strong>Address:</strong> @selectedTask.Address</p>
                <p><strong>EndDate:</strong></p>

                <ul>
                    @foreach (var date in selectedTask.EndDate)
                    {
                        <li>@date.ToString("yyyy-MM-dd")</li>
                    }
                </ul>

            </div>
        }

    }
    @if (selectedTask != null && selectedTask.Description != null)
    {
        <div class="mt-3 p-3 border rounded">
            <h3>VolunteerTask Details</h3>
            <p><strong>Description:</strong> @selectedTask.Description</p>
            <p><strong>Address:</strong> @selectedTask.Address</p>
            <p><strong>EndDate:</strong></p>
            <button class="btn btn-primary" @onclick="() => AssignTask(1)">Assign VolunteerTask</button>

            <ul>
                @foreach (var date in selectedTask.EndDate)
                {
                    <li>@date.ToString("yyyy-MM-dd")</li>
                }
            </ul>
        </div>
    }
    <button class="btn btn-primary" @onclick="() => ChangeForm(0)">Back</button>

}


@code {
    private int whichForm = 0;
    private int prevoiusForm = 0;
    private int volunteerID = 0;

    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string email = string.Empty;
    private char[] phoneNumber = new char[0];
    private string address = string.Empty;


    private string organisationName = string.Empty;

    private string description = string.Empty;
    private int selectedOption = 0;

    private List<DateTime> endDate = new List<DateTime>();
    private DateTime newAvailabilityDate = DateTime.Today;


    private int? selectedOrganisationID;
    private int? previousSelectedOrganisationID;

    private int? selectedVolunteerID;
    private int? previousSelectedVolunteerID;
    private IO.Modules.Volunteer.Volunteer selectedVolunteer = new IO.Modules.Volunteer.Volunteer();
    private Organisation selectedOrganisation = new Organisation();
    private VolunteerTask selectedTask = new VolunteerTask();

    private string selectedOrganisationName =>
        volunteerManager.OrganisationList.FirstOrDefault(o => o.OrganisationID == selectedOrganisationID)?.OrganisationName ?? "None";

    VolunteerManager volunteerManager = new VolunteerManager();

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        volunteerManager.Load();
        Console.WriteLine("Volunteer Page Initialized");
        string sessionUser = await sessionService.GetUserNameAsync();
        //CheckUser(sessionUser);
        Console.WriteLine(sessionUser);
    }


    private void CheckUser(string sessionUser)
    {
        UserExecuter userExecuter = new UserExecuter();
        User user = userExecuter.GetUserFromDataBase(sessionUser);
        bool isVolunteer = false;
        for(int i = 0; i < volunteerManager.VolunteerList.Count; i++)
        {
            if(volunteerManager.VolunteerList[i].Email == sessionUser)
            {
                isVolunteer = true;
                selectedVolunteer = volunteerManager.VolunteerList[i];
                ChangeForm(7);
            }
        }
        bool isOrganisation = false;
        if(!isVolunteer)
        {
            for (int i = 0; i < volunteerManager.OrganisationList.Count; i++)
            {
                if (volunteerManager.OrganisationList[i].Email == sessionUser)
                {
                    isOrganisation = true;
                    selectedOrganisation = volunteerManager.OrganisationList[i];
                    ChangeForm(8);
                }
            }
        }
        if(!isVolunteer && !isOrganisation)
        {
           IO.Modules.Volunteer.Volunteer vol = new IO.Modules.Volunteer.Volunteer(
           firstName,
           lastName,
           email,
           phoneNumber,
           address,
           volunteerManager.OrganisationList.FirstOrDefault(o => o.OrganisationID == selectedOrganisationID)
       );
        }
    }


    private void ChangeSelect(int select)
    {
        selectedTask = null;
        selectedOption = select;
    }

    private void ChangeForm(int form) {
        phoneNumber = new char[0];
        address = string.Empty;
        prevoiusForm = whichForm;
        if(form == 0)
        {
            selectedOption = 0;
            selectedOrganisation = null;
            selectedVolunteer = null;
        }
        whichForm = form;
    }


    private void ShowTaskDetails(VolunteerTask volunteerTask)
    {
        selectedTask = volunteerTask;
    }


    public string PhoneNumberString
    {
        get => new string(phoneNumber);
        set => phoneNumber = value.ToCharArray();
    }
    public string PhoneNumberToString(char[] phoneNumber)
    {
        return new string(phoneNumber);
    }
    private void AddAvailabilityDate()
    {
        if (!endDate.Contains(newAvailabilityDate))
        {
            endDate.Add(newAvailabilityDate);
        }
    }

    private void RemoveAvailabilityDate(DateTime date)
    {
        endDate.Remove(date);
    }


    private void CreateVolunteer(int who)
    {
        IO.Modules.Volunteer.Volunteer vol = new IO.Modules.Volunteer.Volunteer(
            firstName,
            lastName,
            email,
            phoneNumber,
            address,
            volunteerManager.OrganisationList.FirstOrDefault(o => o.OrganisationID == selectedOrganisationID)
        );

        volunteerManager.AddVolunteer(vol);
        if(who == 1)
        {
            selectedVolunteer = vol;
            ChangeForm(7);
        }
    }

    private void CreateOrganisation(int who)
    {
        Organisation org = new Organisation(
            organisationName,
            email,
            phoneNumber,
            address
        );

        volunteerManager.AddOrganisation(org);
        if (who == 1)
        {
            selectedOrganisation = org;
            ChangeForm(8);
        }
    }

    private void CreateTask()
    {
        VolunteerTask volunteerTask = new VolunteerTask(
            description,
            address,
            endDate
        );
        Console.WriteLine(selectedOrganisation.VolunteerTaskList.Count);
        volunteerManager.AddTask(volunteerTask, selectedOrganisation);
        Console.WriteLine(selectedOrganisation.VolunteerTaskList.Count);
    }

    private void AssignTask(int who)
    {
        if(who == 0)
        {
            selectedVolunteer.VolunteerTaskList.Add(selectedTask);
            selectedTask.TaskStatus = IO.Modules.Volunteer.TaskStatus.Assigned;
        }
        if(who == 1)
        {
            selectedOrganisation.VolunteerTaskList.Add(selectedTask);
        }

    }

}



