@if (whichForm == 14)
{
    <h1>Volunteer Information</h1>

    <div>
        <p>Choose Volunteer: </p>
        <select @bind="selectedVolunteerID" class="form-select mt-2">
            <option value="">Select a volunteer</option>
            @foreach (var vol in volunteerList)
            {
                <option value="@vol.VolunteerID">@vol.FirstName @vol.LastName</option>
            }
        </select>
        @if (previousSelectedVolunteerID != selectedVolunteerID)
        {
            previousSelectedVolunteerID = selectedVolunteerID;
            selectedVolunteer = volunteerList.FirstOrDefault(v => v.VolunteerID == selectedVolunteerID);
        }
        @if (selectedVolunteer != null && selectedVolunteer.LastName != null)
        {
            <p>First Name: <input type="text" value="@selectedVolunteer.FirstName" readonly class="form-control" /></p>
            <p>Last Name: <input type="text" value="@selectedVolunteer.LastName" readonly class="form-control" /></p>
            <p>Email: <input type="text" value="@selectedVolunteer.Email" readonly class="form-control" /></p>
            <p>Gender: <input type="text" value="@selectedVolunteer.Gender.ToString()" readonly class="form-control" /></p>
            <p>Phone Number: <input type="text" value="@PhoneNumberToString(selectedVolunteer.PhoneNumber)" readonly class="form-control" /></p>
            <p>Address: <input type="text" value="@selectedVolunteer.Address" readonly class="form-control" /></p>
            <p>Experience: <textarea readonly class="form-control">@selectedVolunteer.Experience</textarea></p>
            <p>Additional Info: <textarea readonly class="form-control">@selectedVolunteer.AdditionalInfo</textarea></p>
            <p>Skills: <textarea readonly class="form-control">@selectedVolunteer.Skills</textarea></p>
            <p>Availability:</p>
            <ul class="list-group">
                @foreach (var date in selectedVolunteer.Availability)
                {
                    <li class="list-group-item">@date.ToString("yyyy-MM-dd")</li>
                }
            </ul>

            <p>Organisation: <input type="text" value="@selectedVolunteer.Organisation.OrganisationName" readonly class="form-control" /></p>

        }

    </div>
    <button class="btn btn-primary" @onclick="() => ChangeForm(4)">Back</button>

}

