@page "/volunteerPage"
@rendermode InteractiveServer
@using IO.Modules.Security
@using IO.Modules.Volunteer
@using IO.Modules.ResourceManager;
@using RequestModule;
@using IO.Modules.MapLibrary
@using IO.Modules.DonorLibrary
@using Microsoft.Extensions.Localization
@using System.Globalization
@using PdfSharp
@using PdfSharp.Drawing
@inject SessionService sessionService
@inject GoogleMapsClient GoogleMaps;
@inject Geolocation Geolocation;
@inject IStringLocalizer<VolunteerPage> Loc
@inject NavigationManager nav

<PageTitle>@Loc["Volunteer"]</PageTitle>

@if (whichForm == 0)
{
    <h1>@Loc["Choose Organisation"]</h1>
    <select @bind="selectedOrganisationID" class="form-select mt-2">
        <option value="">Select an organisation</option>
        @foreach (var org in volunteerManager.OrganisationList)
        {
            <option value="@org.OrganisationID">@org.OrganisationName</option>
        }
    </select>
    @if (previousSelectedOrganisationID != selectedOrganisationID)
    {
        previousSelectedOrganisationID = selectedOrganisationID;
        selectedOrganisation = volunteerManager.OrganisationList.FirstOrDefault(o => o.OrganisationID == selectedOrganisationID);
    }
    @if (selectedOrganisation != null && selectedOrganisation.OrganisationName != null)
    {
        <button class="btn btn-primary" @onclick="() => OrganisationSelected(selectedOrganisation.OrganisationID)">Submit</button>
    }
}
@if (whichForm == 1)
{
}
@if (whichForm == 2)
{
    <h1>@Loc["Hello"] @selectedAffectedName</h1>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(1)">@Loc["Your Requests"]</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(2)">@Loc["Your Rates"]</button>
    @if (selectedOption == 1)
    {
        <ul class="list-group">

            <h3>@Loc["Your Requests"]</h3>
            @foreach (var request in requestList.Where(r => r.User == selectedAffectedEmail))
            {
                <li class="list-group-item" style="cursor: pointer;" @onclick="() => ToggleRequestDetails(request)">
                    @request.Title - @Loc[$"{request.Status}"]
                    @if (selectedRequest == request && showRequestDetails)
                    {
                        <div class="mt-2">
                            <p>@Loc["Description"]: @request.Description</p>
                            <p>@Loc["Created at"]: @request.CreatedAt</p>
                            <p>@Loc["Updated At"]: @request.DateUpdated</p>
                            <p>@Loc["Email of affected"]: @request.User</p>
                            <p>@Loc["Resources Required"]: @string.Join(", ", request.ResourcesRequired.Select(r => $"{r.Name} (x{r.Amount})"))</p>
                            <p>@Loc["Address"]: @request.Address.Street, @request.Address.City, @request.Address.StreetNumber, @request.Address.Apartment, @request.Address.ZipCode</p>
                            <p>@Loc["Is Verified"]: @request.IsVerified</p>
                            <button class="btn btn-primary btn-sm mt-2" @onclick="() => SelectRequest(request)">@Loc["Show Tasks"]</button>
                        </div>
                    }
                </li>
            }
            @if (selectedRequestForTask.Title != null)
            {
                <h3>@Loc["Assigned Tasks To Request"]: @selectedRequestForTask.Title</h3>
                @foreach (var volunteerTask in volunteerManager.VolunteerTaskList.Where(t => t.RequestID == selectedRequestForTask.Id))
                {
                    <li class="list-group-item" style="cursor: pointer;" @onclick="() => ShowTaskDetails(volunteerTask)">
                        @volunteerTask.Description - @Loc[$"{volunteerTask.TaskStatus}"]
                        @if (selectedTask == volunteerTask && showTaskDetails)
                        {
                            <div class="mt-2">
                                <p>@Loc["Address"]: @selectedTask.Address</p>
                                <p>@Loc["Complition date"]: @selectedTask.EndDate.ToString()</p>
                                @if (selectedTask.TaskStatus == IO.Modules.Volunteer.TaskStatus.Assigned)
                                {
                                    <p>
                                        @Loc["Volunteer"]: @volunteerManager.VolunteerList.FirstOrDefault(
                                        v => v.VolunteerID == selectedTask.VolunteerID).FirstName  @volunteerManager.VolunteerList.FirstOrDefault(
                                        v => v.VolunteerID == selectedTask.VolunteerID).LastName
                                    </p>
                                    <p>@Loc["Request"]: @requestManager.GetAllRequests().FirstOrDefault(r => r.Id == selectedTask.RequestID).Title</p>
                                }
                                @if (selectedTask.TaskStatus == IO.Modules.Volunteer.TaskStatus.Completed)
                                {
                                <button class="btn btn-primary btn-sm mt-2" @onclick="() => SelectTaskForRate(selectedTask)">@Loc["Add Rate"]</button>
                                }
                            </div>
                        }

                    </li>
                }
            }
            @if (selectedTaskForRate.Description != null)
            {
                <h3>@Loc["Create Rate"]</h3>

                <div>
                    <p>@Loc["Selected Request"]: </p>
                    <input type="text" @bind="selectedRequestForTask.Title" readonly class="form-control mt-2" />

                    <p>@Loc["Selected Task Description"]: </p>
                    <input type="text" @bind="selectedTaskForRate.Description" readonly class="form-control mt-2" />

                    <p>@Loc["Rate Description"]: </p>
                    <input type="text" @bind="description" placeholder=@Loc["Description"] class="form-control mt-2" />

                    <button class="btn btn-primary" @onclick="CreateRate">@Loc["Submit"]</button>
                </div>
            }
        </ul>
    }

    @if (selectedOption == 2)
    {
        <h3>@Loc["Your Rates"]</h3>
    }        
}

@if (whichForm == 3)
{
    <h1>@Loc["Hello"] @selectedVolunteer.FirstName</h1>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(1)">@Loc["Available Tasks"]</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(2)">@Loc["Your Active Tasks"]</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(3)">@Loc["Your Completed Tasks"]</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(4)">@Loc["Your Rates"]</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(5)">@Loc["Your Profile"]</button>


    @if (selectedOption == 1)
    {
        <h3>@Loc["Available Tasks"]</h3>
        <ul class="list-group">
            @foreach (var volunteerTask in volunteerManager.FindTasksByOrganisation(selectedVolunteer.OrganisationID).Where(
                t => t.TaskStatus == IO.Modules.Volunteer.TaskStatus.New))
            {
                <li class="list-group-item" style="cursor: pointer;" >
                    <p @onclick="() => ShowTaskDetails(volunteerTask)">@volunteerTask.Description - @Loc[$"{volunteerTask.TaskStatus}"]</p>
                
                    @if (selectedTask == volunteerTask && showTaskDetails)
                    {
                        <div class="mt-2">
                            <p>@Loc["Complition date"]: @selectedTask.EndDate.ToString()</p>
                            <p>@Loc["Address"]: @selectedTask.Address</p>
                            <div id="map01" style="width: 100%; height: 500px; margin-top: 20px;"></div>
                            <button class="btn btn-primary btn-sm mt-2" @onclick="() => AssignTask()">@Loc["Assign Task"]</button>
                        </div>
                    }

                </li>
            }
        </ul>
    }

    @if(selectedOption == 2)
    {
        <h3>@Loc["Your Active Tasks"]</h3>
        <ul class="list-group">
            @foreach (var volunteerTask in volunteerManager.FindTasksByVolunteer(selectedVolunteer.VolunteerID).Where(
                t => t.TaskStatus == IO.Modules.Volunteer.TaskStatus.Assigned))
            {
                <li class="list-group-item" style="cursor: pointer;">
                    <p @onclick="() => ShowTaskDetails(volunteerTask)">@volunteerTask.Description - @Loc[$"{volunteerTask.TaskStatus}"]</p>
                    @if (selectedTask == volunteerTask && showTaskDetails)
                    {
                        <div class="mt-2">
                            <p>@Loc["Complition date"]: @selectedTask.EndDate.ToString()</p>
                            <p>@Loc["Address"]: @selectedTask.Address</p>
                            <div id="map01" style="width: 100%; height: 500px; margin-top: 20px;"></div>
                            <div style="display: flex; flex-direction: column-reverse; gap: 10px;">
                                @for (var index = fieldValues.Count - 1; index >= 0; index--)
                                {
                                    Console.WriteLine(index);
                                    var i = index;
                                    <div id="textfield-container" style="display: flex; align-items: center; gap: 5px;">
                                        <input class="form-control" type="text" @bind="fieldValues[i]" placeholder="Enter address or location" style="flex: 1;" />

                                        <div class="d-flex flex-column justify-content-between" style="height: 100%; width: 40px;">
                                            @if (i != 0)
                                            {
                                                <button class="btn btn-primary btn-sm p-0 w-100" style="height: 45%;" @onclick="() => MoveFieldUp(i)">
                                                    <span class="bi bi-caret-up-fill" style="font-size: 75%;"></span>
                                                </button>
                                            }
                                            @if (i != fieldCount - 1)
                                            {
                                                <button class="btn btn-primary btn-sm p-0 w-100" style="height: 45%;" @onclick="() => MoveFieldDown(i)">
                                                    <span class="bi bi-caret-down-fill" style="font-size: 75%;"></span>
                                                </button>
                                            }
                                        </div>

                                        @if (fieldValues.Count > 1)
                                        {
                                            <button class="btn btn-danger" @onclick="() => RemoveField(i)">-</button>
                                        }
                                    </div>
                                }
                                <div style="display: flex; gap: 10px;">
                                    <button class="btn btn-success" @onclick="AddField">+</button>
                                    <button class="btn btn-primary" @onclick="() => ConfirmFields()">
                                        @Loc["Update midpoints"]
                                    </button>
                                </div>
                            </div>
                            <button class="btn btn-primary btn-sm mt-2" @onclick="() => UpdateTaskStatus(IO.Modules.Volunteer.TaskStatus.Completed)">@Loc["Complete Task"]</button>
                        </div>
                    }

                </li>
            }
        </ul>
    }

    @if (selectedOption == 3)
    {
        <h3>@Loc["Your Completed Tasks"]</h3>
        <ul class="list-group">
            @foreach (var volunteerTask in volunteerManager.FindTasksByVolunteer(selectedVolunteer.VolunteerID).Where(
                t => t.TaskStatus == IO.Modules.Volunteer.TaskStatus.Completed || t.TaskStatus == IO.Modules.Volunteer.TaskStatus.Archived))
            {
                @if(volunteerManager.RateList.Any(r => r.RateID == volunteerTask.RateID))
                {
                <li class="list-group-item" style="cursor: pointer;">
                        <p @onclick="() => ShowTaskDetails(volunteerTask)">@volunteerTask.Description - @Loc[$"{volunteerTask.TaskStatus}"] @Loc["Rated"]</p>

                    @if (selectedTask == volunteerTask && showTaskDetails)
                    {
                        <div class="mt-2">
                                <p>@Loc["Address"]: @selectedTask.Address</p>
                                <p>@Loc["Complition date"]: @selectedTask.EndDate.ToString()</p>
                            <p>@Loc["Rate"]: @volunteerManager.RateList.FirstOrDefault(r => r.RateID == selectedTask.RateID).Description </p>
                        </div>
                    }
                    </li>
                }
                else
                {
                    <li class="list-group-item" style="cursor: pointer;">
                        <p @onclick="() => ShowTaskDetails(volunteerTask)">@volunteerTask.Description - @Loc[$"{volunteerTask.TaskStatus}"]</p>
                       

                        @if (selectedTask == volunteerTask && showTaskDetails)
                        {
                            <div class="mt-2">
                                <p>@Loc["Complition date"]: @selectedTask.EndDate.ToString()</p>
                                <p>@Loc["Address"]: @selectedTask.Address</p>
                                <div id="map01" style="width: 100%; height: 500px; margin-top: 20px;"></div>
                            </div>
                        }
                    </li>
                }
            }
        </ul>
    }
    @if (selectedOption == 4)
    {
        <h3>@Loc["Your Rates"]</h3>
        <ul class="list-group">
            @foreach (var volunteerTask in volunteerManager.FindTasksByVolunteer(selectedVolunteer.VolunteerID).Where(
                t => t.RateID > 0))
            {
                <li class="list-group-item" style="cursor: pointer;" @onclick="() => ShowTaskDetails(volunteerTask)"> Rate Description: 
                    @volunteerManager.RateList.FirstOrDefault(r => r.RateID == volunteerTask.RateID).Description

                    @if (selectedTask == volunteerTask && showTaskDetails)
                    {
                        <div class="mt-2">
                            <p>@Loc["This rate was for task"]: @selectedTask.Description</p>
                        </div>
                    }

                </li>
            }
        </ul>
    }
    @if(selectedOption == 5)
    {
        <h3>@Loc["Your profile"]</h3>
        <form method="post" @onsubmit="editVolunteer">
            <p>@Loc["First Name"]: <input type="text" @bind-value="selectedVolunteer.FirstName" class="form-control" /></p>
            <p>@Loc["Surname"]: <input type="text" @bind-value="selectedVolunteer.LastName" class="form-control" /></p>
            <p>@Loc["Email"]: <input type="text" value="@selectedVolunteer.Email" readonly class="form-control" /></p>
            <p>@Loc["Phone Number"]: <input type="text" @bind-value="selectedVolunteer.PhoneNumber" class="form-control" /></p>
            <p>@Loc["Address"]: <input type="text" @bind-value="selectedVolunteer.Address" class="form-control" /></p>
            <p>@Loc["Organisation"]: <input type="text" value="@volunteerManager.FindOrganisationByID(selectedVolunteer.OrganisationID).OrganisationName" readonly class="form-control" /></p>
            <button type="submit" class="btn btn-primary">@Loc["Save Changes"]</button>
        </form>
    }

}


@if (whichForm == 4)
{
    <h1>Hello @selectedOrganisation.OrganisationName</h1>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(1)">@Loc["Create Task"]</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(2)">@Loc["Your Tasks"]</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(3)">@Loc["Your Volunteers"]</button>
    <button class="btn btn-primary" @onclick="() => ChangeSelect(4)">@Loc["Your Profile"]</button>
   
    @if (selectedOption == 1)
    {
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-4">
                    <h3>Requests</h3>
                    <ul class="list-group">
                        @foreach (var request in requestList)
                        {
                            <li class="list-group-item" style="cursor: pointer;">
                                <p @onclick="() => ToggleRequestDetails(request)">@request.Title - @Loc[$"{request.Status}"]</p>
                                
                                @if (selectedRequest == request && showRequestDetails)
                                {
                                    <div class="mt-2">
                                        <p>@Loc["Description"]: @request.Description</p>
                                        <p>@Loc["Created at"]: @request.CreatedAt</p>
                                        <p>@Loc["Updated At"]: @request.DateUpdated</p>
                                        <p>@Loc["Email of affected"]: @request.User</p>
                                        <p>@Loc["Resources Required"]: @string.Join(", ", request.ResourcesRequired.Select(r => $"{r.Name} (x{r.Amount})"))</p>
                                        <p>@Loc["Is Verified"]: @request.IsVerified</p>
                                        <p>@Loc["Address"]: @request.Address.Street, @request.Address.City, @request.Address.StreetNumber, @request.Address.Apartment, @request.Address.ZipCode</p>
                                        <div id="map01" style="width: 100%; height: 500px; margin-top: 20px;"></div>
                                        <button class="btn btn-primary btn-sm mt-2" @onclick="() => SelectRequest(request)">@Loc["Select"]</button>
                                        <button class="btn btn-primary btn-sm mt-2" @onclick="() => ChangeRequestStatus(request, RequestStatus.InProgress)">@Loc["Change Status"]</button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </div>

                <div class="col-md-8">
                    <h3>@Loc["Create Task"]</h3>

                    <div>
                        <p>@Loc["Description"]: </p>
                        <input type="text" @bind="description" class="form-control mt-2" />

                        <p>@Loc["Address"]: </p>
                        <input type="text" @bind="address" class="form-control mt-2" />

                        <p>@Loc["Selected Request"]: </p>
                        <input type="text" @bind="selectedRequestForTask.Title" readonly class="form-control mt-2" />

                        <p>@Loc["EndDate"]: </p>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="date" @bind="endDate" class="form-control" />
                        </div>

                        <button class="btn btn-primary" @onclick="CreateTask">@Loc["Submit"]</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (selectedOption == 2)
    {
        <h3>@Loc["Your Tasks"]</h3>

        <ul class="list-group">
            @foreach (var volunteerTask in volunteerManager.FindTasksByOrganisation(selectedOrganisation.OrganisationID))
            {
                <li class="list-group-item" style="cursor: pointer;">
                    <p @onclick="() => ShowTaskDetails(volunteerTask)">@volunteerTask.Description - @Loc[$"{volunteerTask.TaskStatus}"]</p>
                    
                    @if (selectedTask == volunteerTask && showTaskDetails)
                    {
                        <div class="mt-2">
                            <p>@Loc["Complition date"]: @selectedTask.EndDate.ToString()</p>
                            @if(selectedTask.TaskStatus == IO.Modules.Volunteer.TaskStatus.Assigned)
                            {
                            <p>@Loc["Volunteer"]: @volunteerManager.VolunteerList.FirstOrDefault(
                                v => v.VolunteerID == selectedTask.VolunteerID).FirstName  @volunteerManager.VolunteerList.FirstOrDefault(
                                v => v.VolunteerID == selectedTask.VolunteerID).LastName @volunteerManager.VolunteerList.FirstOrDefault(
                                v => v.VolunteerID == selectedTask.VolunteerID).Email
                                </p>
                            <p>@Loc["Request"]: @requestManager.GetAllRequests().FirstOrDefault(r => r.Id == selectedTask.RequestID).Title</p>
                                <p>@Loc["Address"]: @selectedTask.Address</p>
                                <div id="map01" style="width: 100%; height: 500px; margin-top: 20px;"></div>
                            }
                        </div>
                    }

                </li>
            }
        </ul>

    }
    @if (selectedOption == 3)
    {
        <h1>@Loc["Your Volunteers"]</h1>

        <ul class="list-group">
            @foreach (var volunteer in volunteerManager.FindVolunteersByOrganisation(selectedOrganisation.OrganisationID))
            {
                <li class="list-group-item" style="cursor: pointer;">
                    <p @onclick="() => ShowVolunteerDetails(volunteer)">@volunteer.FirstName @volunteer.LastName</p>
                    
                    @if (selectedVolunteer == volunteer && showVolunteerDetails)
                    {
                        <div class="mt-2">
                            <p>@Loc["Phone Number"]: @selectedVolunteer.PhoneNumber</p>
                            <p>@Loc["Email"]: @selectedVolunteer.Email</p>
                            <p>@Loc["Tasks"]: @volunteerManager.FindTasksByVolunteer(selectedVolunteer.VolunteerID).Count</p>
                            <p>@Loc["Address"]: @selectedVolunteer.Address</p>
                        </div>
                    }

                </li>
            }
        </ul>

    }
    @if (selectedOption == 4)
    {
        <h1>@Loc["Your Profile"]</h1>
        <form method="post" @onsubmit="editOrganisation">
            <p>@Loc["Organisation Name"]: <input type="text" @bind-value="selectedOrganisation.OrganisationName" class="form-control" /></p>
              <p>@Loc["Email"]: <input type="text" value="@selectedOrganisation.Email" readonly class="form-control" /></p>
              <p>@Loc["Phone Number"]: <input type="text" @bind-value="selectedOrganisation.PhoneNumber" class="form-control" /></p>
              <p>@Loc["Address"]: <input type="text" @bind-value="selectedOrganisation.Address" class="form-control" /></p>
              <p>@Loc["Website"]: <input type="text" @bind-value="selectedOrganisation.Website" class="form-control" /></p>
            <p>KRS: <input type="text" @bind-value="selectedOrganisation.KRS" class="form-control" /></p>
            <button type="submit" class="btn btn-primary">@Loc["Save Changes"]</button>
        </form>
    }

}
<footer class="footer">
    <button @onclick="Polish" class="lang">Polski</button>
    <button @onclick="English" class="lang">English</button>
</footer>

@code {
    private int whichForm = 0;
    private int prevoiusForm = 0;
    private int volunteerID = 0;

    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string email = string.Empty;
    private string phoneNumber = string.Empty;
    private string address = string.Empty;
    private string website = string.Empty;
    private string kRS = string.Empty;


    private string organisationName = string.Empty;


    private Request selectedRequest;
    private bool showRequestDetails = false;
    private bool showTaskDetails = false;
    private bool showVolunteerDetails = false;


    private string description = string.Empty;
    private int selectedOption = 0;

    private DateTime endDate = DateTime.Today;
    private int selectedOrganisationID;
    private string selectedAffectedEmail = string.Empty;
    private string selectedAffectedName = string.Empty;
    private VolunteerTask selectedTaskForRate = new VolunteerTask();
    private Rate selectedRate = new Rate();
    private int previousSelectedOrganisationID; 
    private Request selectedRequestForTask = new Request();
    private int? selectedVolunteerID;
    private int? previousSelectedVolunteerID;
    private IO.Modules.Volunteer.Volunteer selectedVolunteer = new IO.Modules.Volunteer.Volunteer();
    private Organisation selectedOrganisation = new Organisation();
    private VolunteerTask selectedTask = new VolunteerTask();
    private List<Request> requestList = new List<Request>();
    RequestManager requestManager = new RequestManager();
    private string selectedOrganisationName =>
        volunteerManager.OrganisationList.FirstOrDefault(o => o.OrganisationID == selectedOrganisationID)?.OrganisationName ?? "None";

    VolunteerManager volunteerManager = new VolunteerManager();


    private MapController map01;
    private int fieldCount = 1;
    private List<string> fieldValues = new List<string> { "" };
    private string globalAddress = string.Empty;




    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        volunteerManager.Load();
        map01 = new(GoogleMaps, "map01");

        requestList = requestManager.GetAllRequests();
        string sessionUser = await sessionService.GetUserNameAsync();
        CheckUser(sessionUser);
        if (selectedVolunteer != null)
        {
            if (selectedVolunteer.OrganisationID == -1)
            {
                ChangeForm(0);
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            await GoogleMaps.InitializeApi();
        }
    }

    private void CheckUser(string sessionUser)
    {
        UserExecuter userExecuter = new UserExecuter();
        BasicUser basicUser = userExecuter.GetBasicUser(sessionUser);

        if (basicUser != null)
        {

            if (basicUser.Role == "Volunteer")
            {
                if (volunteerManager.VolunteerList.Any(v => v.Email == sessionUser))
                {
                    selectedVolunteer = volunteerManager.VolunteerList.FirstOrDefault(v => v.Email == sessionUser);
                }
                else
                {
                    IO.Modules.Volunteer.Volunteer vol = new IO.Modules.Volunteer.Volunteer(
                        basicUser.Name,
                        basicUser.Surname,
                        basicUser.Email,
                        basicUser.PhoneNumber,
                        basicUser.Address,
                        -1);
                    selectedVolunteer = vol;
                    //volunteerManager.AddVolunteer(vol);
                }
                if(selectedVolunteer.OrganisationID == -1)
                {
                    ChangeForm(0);
                }
                else
                {
                    ChangeForm(3);
                }
                globalAddress = selectedVolunteer.Address;
            }
            else if (basicUser.Role == "Charity")
            {
                if (volunteerManager.OrganisationList.Any(o => o.Email == sessionUser))
                {
                    selectedOrganisation = volunteerManager.OrganisationList.FirstOrDefault(o => o.Email == sessionUser);
                }
                else
                {
                    Organisation org = new Organisation(
                        basicUser.Name,
                        basicUser.Email,
                        basicUser.PhoneNumber,
                        basicUser.Address,
                        basicUser.Website,
                        basicUser.Krs
                    );

                    volunteerManager.AddOrganisation(org);
                    selectedOrganisation = org;
                }
                ChangeForm(4);
                globalAddress = selectedOrganisation.Address;
            }
            else if(basicUser.Role == "Affected")
            {
                selectedAffectedEmail = basicUser.Email;
                selectedAffectedName = basicUser.Name;
                ChangeForm(2);
                globalAddress = basicUser.Address;
            }

        }
        else
        {

            ChangeForm(1);
        }

    }

    private void OrganisationSelected(int organisationID)
    {
        selectedVolunteer.OrganisationID = organisationID;
        volunteerManager.AddVolunteer(selectedVolunteer);
        selectedOrganisation = null;
        ChangeForm(3);
    }

    private void ChangeSelect(int select)
    {
        selectedTask = null;
        selectedOption = select;
    }

    private void ChangeForm(int form) {
        phoneNumber = string.Empty;
        address = string.Empty;
        prevoiusForm = whichForm;
        whichForm = form;
    }




    private void editOrganisation()
    {
        volunteerManager.EditOrganisation(selectedOrganisation);
    }
    private void editVolunteer()
    {
        volunteerManager.EditVolunteer(selectedVolunteer);
    }


    private void CreateTask()
    {
        VolunteerTask volunteerTask = new VolunteerTask(
            description,
            address,
            endDate,
            selectedOrganisation.OrganisationID,
            selectedRequestForTask.Id

        );
        volunteerManager.AddTask(volunteerTask);
    }

    private void CreateRate()
    {
        Rate rate = new Rate(
            description
        );
        volunteerManager.AddRate(rate, selectedTaskForRate.VolunteerTaskID);
        volunteerManager.UpdateTaskStatus(selectedTaskForRate, IO.Modules.Volunteer.TaskStatus.Archived);
        selectedTaskForRate = new VolunteerTask();

    }

    private void AssignTask()
    {
        volunteerManager.AssignTask(selectedTask, selectedVolunteer);
    }
    private void UpdateTaskStatus(IO.Modules.Volunteer.TaskStatus taskStatus)
    {
        if(taskStatus == IO.Modules.Volunteer.TaskStatus.Completed)
        {
            selectedTask.EndDate = DateTime.Today;
        }

        volunteerManager.UpdateTaskStatus(selectedTask, taskStatus);
    }
    private async void ToggleRequestDetails(Request request)
    {
        if (selectedRequest == request)
        {
            showRequestDetails = !showRequestDetails;
        }
        else
        {
            selectedRequest = request;
            map01.SetLocation(selectedRequest.Address);
            showRequestDetails = true;
        }
        if (showRequestDetails)
        {

            await map01.DrawMap();

        }
    }

    private async void ShowTaskDetails(VolunteerTask volunteerTask)
    {
