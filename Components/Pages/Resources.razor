@page "/resources"
@using IO.Modules.ResourceManager

<h3>Resources</h3>

<label for="categorySelect">Select Category:</label>
<select id="categorySelect" @bind="selectedCategory">
    <option value="">-- Select a Category --</option>
    @foreach (var category in availableCategories)
    {
        <option value="@category">@category</option>
    }
</select>

<h4>Filtered Resources</h4>
@if (filteredResources != null && filteredResources.Any())
{
    <ul>
        @foreach (var resource in filteredResources)
        {
            <li>@resource</li>
        }
    </ul>
}
else if (!string.IsNullOrEmpty(selectedCategory))
{
    <p>No resources found for the selected category.</p>
}
else
{
    <p>Please select a category to see resources.</p>
}

@code {
    private IResManager _manager = new Executor();
    private string selectedCategory = string.Empty;
    private List<string> availableCategories = new();
    private List<string> filteredResources = new();

    protected override void OnInitialized()
    {
        // Initialize available categories
        availableCategories.Add("All");
        availableCategories.AddRange(Enum.GetNames(typeof(Category)).ToList());
    }

    private string SelectedCategory
    {
        get => selectedCategory;
        set
        {
            if (selectedCategory != value)
            {
                selectedCategory = value;
                ApplyFilter(); // Trigger filtering logic when category changes
            }
        }
    }

    private void ApplyFilter()
    {
        if (selectedCategory == "All")
        {
            filteredResources = _manager.GetAllAvailableItems();
        }
        else if (!string.IsNullOrEmpty(selectedCategory))
        {
            filteredResources = _manager.GetItemsByCategory(selectedCategory);
        }
        else
        {
            filteredResources.Clear();
        }
    }
}
