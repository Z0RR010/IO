@page "/resources"
@using IO.Modules.ResourceManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> Loc
@inject NavigationManager nav
@rendermode InteractiveServer

<h3>@Loc["Resources"]</h3>

<label for="categorySelect">@Loc["SelectCategory"]</label>
<select id="categorySelect" @bind="selectedCategory">
    <option value="">@Loc["SelectCategoryOption"]</option>
    @foreach (var category in availableCategories)
    {
        <option value="@category">@category</option>
    }
</select>

<button @onclick="FilterResources">@Loc["ApplyFilter"]</button>

<h4>@Loc["FilteredResources"]</h4>
@if (filteredResources != null && filteredResources.Any())
{
    <ul>
        @foreach (var resource in filteredResources)
        {
            <li>@resource</li>
        }
    </ul>
}
else if (filterApplied)
{
    <p>@Loc["NoResourcesFound"]</p>
}
else
{
    <p>@Loc["PleaseSelectCategory"]</p>
}

<footer class="footer">
    <button class="lang" @onclick="Polish">Polski</button>
    <button class="lang" @onclick="English">English</button>
</footer>

@code {
    private IResManager _manager = new Executor();
    private string selectedCategory = string.Empty;
    private List<string> availableCategories = new();
    private List<string> filteredResources = new();
    private bool filterApplied = false;

    protected override void OnInitialized()
    {
        // Initialize available categories
        availableCategories.Add("All");
        availableCategories.AddRange(Enum.GetNames(typeof(Category)).ToList());
    }

    private void FilterResources()
    {
        filterApplied = true;

        if (selectedCategory == "All")
        {
            filteredResources = _manager.GetAllAvailableItems();
        }
        else if (!string.IsNullOrEmpty(selectedCategory))
        {
            filteredResources = _manager.GetItemsByCategory(selectedCategory);
        }
        else
        {
            filteredResources.Clear();
        }
    }

    private async Task English()
    {
        String newUri = nav.Uri;
        if (newUri.Contains("?ui-culture=pl"))
        {
            newUri = newUri.Replace("?ui-culture=pl", "?ui-culture=en-US");
        }
        if (!newUri.Contains("?ui-culture=en-US"))
        {
            newUri += "?ui-culture=en-US";
        }
        nav.NavigateTo(newUri, true);
    }

    private async Task Polish()
    {
        String newUri = nav.Uri;
        if (newUri.Contains("?ui-culture=en-US"))
        {
            newUri = newUri.Replace("?ui-culture=en-US", "?ui-culture=pl");
        }
        if (!newUri.Contains("?ui-culture=pl"))
        {
            newUri += "?ui-culture=pl";
        }
        nav.NavigateTo(newUri, true);
    }
}