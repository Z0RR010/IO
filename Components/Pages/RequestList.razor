@page "/requests"
@rendermode InteractiveServer
@inject IO.Modules.Security.SessionService sessionService
@using IO.Modules.Security
@using IO.Modules.ResourceManager
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IStringLocalizer<RequestList> Loc
@inject NavigationManager nav
<title>@Loc["Tit"]</title>
<h3>@Loc["Header"]</h3>

@if (requests == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Loc["Title"]</th>
                <th>@Loc["Description"]</th>
                <th>Status</th>
                <th>@Loc["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in requests)
            {
                <tr>
                    <td>@request.Title</td>
                    <td>@request.Description</td>
                    <td>@Loc[$"{request.Status}"]</td>
                    <td>
                        <a href="@GetDetailsUrl(request.Id)">@Loc["Details"]</a>
                        <a href="@GetEditUrl(request.Id)">@Loc["Edit"]</a>
                        <button type="button" class="btn btn-primary" @onclick="() => DeleteRequest(request.Id)">@Loc["Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <footer class="footer">
        <button @onclick="Polish" class="lang">Polski</button>
        <button @onclick="English" class="lang">English</button>
    </footer>
}

