@page "/requests"
@rendermode InteractiveServer
@inject RequestModule.IRequestService RequestService
@using IO.Modules.Security

<h3>Requests</h3>

@if (requests == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in requests)
            {
                <tr>
                    <td>@request.Title</td>
                    <td>@request.Description</td>
                    <td>@request.Status</td>
                    <td>
                        <a href="/requests/details/@request.Id">Details</a>
                        <a href="/requests/edit/@request.Id">Edit</a>
                        <button type="button" class="btn btn-primary" @onclick="() => DeleteRequest(request.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RequestModule.Request> requests;
    private IO.Modules.ResourceManager.RequestManager requestManager = new IO.Modules.ResourceManager.RequestManager();

    protected override async Task OnInitializedAsync()
    {
        requests = requestManager.GetAllRequests();
    }

    private async Task DeleteRequest(int id)
    {
        bool deleted = false;
        try
        {
            deleted = await requestManager.RemoveRequestFromDatabase(id);
        }
        catch (Exception ex)
        {
            // Log the exception (ex) if necessary
            Console.WriteLine($"Error deleting request: {ex.Message}");
        }
        if (deleted)
        {
            var requestToRemove = requests.FirstOrDefault(r => r.Id == id);
            if (requestToRemove != null)
            {
                requests.Remove(requestToRemove);
            }
            StateHasChanged();
            Console.WriteLine("Request deleted.");
        }
    }
}
