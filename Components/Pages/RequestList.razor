@code {
    private List<RequestModule.Request> requests;
    private IO.Modules.ResourceManager.RequestManager requestManager = new IO.Modules.ResourceManager.RequestManager();
    private String email;
    protected override async Task OnInitializedAsync()
    {
        var uri = nav.ToAbsoluteUri(nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        // if (!query.ContainsKey("ui-culture"))
        // {
        //     nav.NavigateTo($"{uri.AbsolutePath}?ui-culture=en-US", true);
        //     return;
        // }

        await base.OnInitializedAsync();
        email = await sessionService.GetUserNameAsync();
        UserExecuter userExecuter = new UserExecuter();
        BasicUser basicUser = userExecuter.GetBasicUser(email);
        if (email == "Anonymous")
        {
            nav.NavigateTo("",true);
        }
        switch (basicUser.Role)
        {
            case "Affected":
                {
                    requests = requestManager.GetUserRequests(email);
                    break;
                }
            case "Charity":
            case "Authority":
            case "Admin":
                {
                    requests = requestManager.GetAllRequests();
                    break;
                }
            default:
                {
                    requests = new List<RequestModule.Request>();
                    break;
                }
        }
    }

    private async Task DeleteRequest(int id)
    {
        bool deleted = false;
        try
        {
            deleted = await requestManager.RemoveRequestFromDatabase(id);
        }
        catch (Exception ex)
        {
            // Log the exception (ex) if necessary
            Console.WriteLine($"Error deleting request: {ex.Message}");
        }
        if (deleted)
        {
            var requestToRemove = requests.FirstOrDefault(r => r.Id == id);
            if (requestToRemove != null)
            {
                requests.Remove(requestToRemove);
            }
            StateHasChanged();
            Console.WriteLine("Request deleted.");
        }
    }

    private string GetDetailsUrl(int id)
    {
        var uri = nav.ToAbsoluteUri(nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var culture = query.ContainsKey("ui-culture") ? query["ui-culture"].ToString() : "en-US";
        return $"/requests/details/{id}?ui-culture={culture}";
    }

    private string GetEditUrl(int id)
    {
        var uri = nav.ToAbsoluteUri(nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var culture = query.ContainsKey("ui-culture") ? query["ui-culture"].ToString() : "en-US";
        return $"/requests/edit/{id}?ui-culture={culture}";
    }

        private async Task English()
        {
            String newUri = nav.Uri;
            String oldUri = nav.Uri;
            if (newUri.Contains("?ui-culture=pl"))
            {
                newUri = newUri.Replace("?ui-culture=pl", "?ui-culture=en-US");
            }
            if (!newUri.Contains("?ui-culture=en-US"))
            {
                newUri += "?ui-culture=en-US";
            }
            nav.NavigateTo(newUri, true);
        }

        private async Task Polish()
        {
            String newUri = nav.Uri;
            if (newUri.Contains("?ui-culture=en-US"))
            {
                newUri = newUri.Replace("?ui-culture=en-US", "?ui-culture=pl");
            }
            if (!newUri.Contains("?ui-culture=pl"))
            {
                newUri += "?ui-culture=pl";
            }
            nav.NavigateTo(newUri, true);
        }


}
