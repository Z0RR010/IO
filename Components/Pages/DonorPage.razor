@page "/donorPage"
@using IO.Modules.DonorLibrary
@using PdfSharp
@using PdfSharp.Drawing
@rendermode InteractiveServer

<PageTitle>Donor</PageTitle>

<h1 style="color: white;">Donor</h1>
<button class="btn btn-primary" @onclick="Donate">Donate</button>
<button class="btn btn-primary" @onclick="ShowDonations">Show Donations</button>

@if (whichForm == 1)
{
    <h1 style="color: white;">Donate</h1>

    <div>
        <p style="color: white;">Item Name:</p>
        <input type="text" @bind="itemName" placeholder="Enter item name" class="form-control mt-2" />

        <p style="color: white;">Quantity:</p>
        <input type="text" @bind="quantity" placeholder="Enter item quantity" class="form-control mt-2" />

        <button class="btn btn-success mt-3" @onclick="SubmitDonation">Submit</button>
    </div>
}

@if (whichForm == 2)
{
    <h2 style="color: white;">List of Donations</h2>
    <table class="table">
        <thead>
            <tr>
                <th style="color: white;"><input type="checkbox" @bind="selectAll" @onclick="ToggleSelectAll" /> </th>
                <th style="color: white;" @onclick="() => SortById()">
                    ID
                    <span>@(sortDirection == SortOrder.Ascending && sortBy == "Id" ? "↓" : sortDirection == SortOrder.Descending && sortBy == "Id" ? "↑" : "")</span>
                </th>
                <th style="color: white;" @onclick="() => SortByName()">
                    Item Name
                    <span>@(sortDirection == SortOrder.Ascending && sortBy == "Name" ? "↓" : sortDirection == SortOrder.Descending && sortBy == "Name" ? "↑" : "")</span>
                </th>
                <th style="color: white;" @onclick="() => SortByQuantity()">
                    Quantity
                    <span>@(sortDirection == SortOrder.Ascending && sortBy == "Quantity" ? "↓" : sortDirection == SortOrder.Descending && sortBy == "Quantity" ? "↑" : "")</span>
                </th>
                <th style="color: white;" @onclick="() => SortByDate()">
                    Date
                    <span>@(sortDirection == SortOrder.Ascending && sortBy == "Date" ? "↓" : sortDirection == SortOrder.Descending && sortBy == "Date" ? "↑" : "")</span>
                </th>
                <th style="color: white;" @onclick="() => SortByStatus()">
                    Status
                    <span>@(sortDirection == SortOrder.Ascending && sortBy == "Status" ? "↓" : sortDirection == SortOrder.Descending && sortBy == "Status" ? "↑" : "")</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var donation in SortedDonations)
            {
                <tr>
                    <td style="color: white;"><input type="checkbox" @bind="donation.Selected" /></td>
                    <td style="color: white;">@donation.DonationID</td>
                    <td style="color: white;">@donation.Item</td>
                    <td style="color: white;">@donation.Quantity</td>
                    <td style="color: white;">@donation.Date</td>
                    <td style="color: white;">@donation.DonationStatus</td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary mt-3" @onclick="GenerateReport" disabled="@(!IsAnyDonationSelected)">Generate Report</button>
}
@if (!string.IsNullOrEmpty(savedFileMessage))
{
    <div class="custom-message">
    <span>@savedFileMessage</span>
    <button class="close-btn" @onclick="HideMessage">&times;</button>
    </div>
}

@code {
    private int whichForm = 0;
    private string itemName;
    private int quantity;
    private string savedFileMessage;
    private List<Donation> selectedDonations = new List<Donation>();
    private DonationManager donationManager = new DonationManager();
    private bool IsAnyDonationSelected => donationManager.GetAllDonations().Any(d => d.Selected);
    private string sortBy = "";
    private SortOrder sortDirection = SortOrder.Ascending;
    private List<Donation> SortedDonations => SortDonations(donationManager.GetAllDonations());

    protected override void OnInitialized()
    {
        SortById();
    }

    private bool AreAllDonationsSelected()
    {
        return donationManager.GetAllDonations().All(d => d.Selected);
    }

    private bool selectAll
    {
        get { return AreAllDonationsSelected(); }
        set
        {
            foreach (var donation in donationManager.GetAllDonations())
            {
                donation.Selected = value;
            }
        }
    }

    private void Donate()
    {
        whichForm = 1;
    }

    private void ShowDonations()
    {
        whichForm = 2;
    }

    private void SubmitDonation()
    {
        string date = DateTime.Now.ToString("dd-MM-yyyy");
        donationManager.AddDonation(itemName, quantity, date);
        itemName = string.Empty;
        quantity = 0;
        whichForm = 0;
    }

    private void ToggleSelectAll()
    {
        var isSelected = AreAllDonationsSelected();
        foreach (var donation in donationManager.GetAllDonations())
        {
            donation.Selected = !isSelected;
        }
    }

    private void GenerateReport()
    {
        if (!IsAnyDonationSelected)
        {
            return;
        }
        SavePdfReportToDownloads();
    }

    private void SavePdfReportToDownloads()
    {
        var pdfData = GeneratePdfReport();
        string downloadsFolder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
        int counter = 1;
        string filePath;
        do
        {
            filePath = Path.Combine(downloadsFolder, $"donation_report{counter}.pdf");
            counter++;
        } while (File.Exists(filePath));

        File.WriteAllBytes(filePath, pdfData);
        savedFileMessage = $"File saved to: {filePath}";
    }

    private byte[] GeneratePdfReport()
    {
        PdfSharp.Pdf.PdfDocument document = new PdfSharp.Pdf.PdfDocument();
        document.Info.Title = "Donation Report";

        PdfSharp.Pdf.PdfPage page = document.AddPage();
        XGraphics gfx = XGraphics.FromPdfPage(page);
        XFont font = new XFont("Verdana", 12);

        double yPoint = 40;
        gfx.DrawString("Selected Donations Report", font, XBrushes.Black,
          new XRect(0, yPoint, page.Width, page.Height),
          XStringFormats.TopCenter);

        yPoint += 40;
        foreach (var donation in donationManager.GetAllDonations().Where(d => d.Selected))
        {
            gfx.DrawString($"ID: {donation.DonationID}", font, XBrushes.Black, 40, yPoint);
            yPoint += 20;
            gfx.DrawString($"Item: {donation.Item}", font, XBrushes.Black, 40, yPoint);
            yPoint += 20;
            gfx.DrawString($"Quantity: {donation.Quantity}", font, XBrushes.Black, 40, yPoint);
            yPoint += 20;
            gfx.DrawString($"Date: {donation.Date}", font, XBrushes.Black, 40, yPoint);
            yPoint += 20;
            gfx.DrawString($"Status: {donation.DonationStatus}", font, XBrushes.Black, 40, yPoint);
            yPoint += 40;
        }

        using (var memoryStream = new MemoryStream())
        {
            document.Save(memoryStream, false);
            return memoryStream.ToArray();
        }
    }

    private void HideMessage()
    {
        savedFileMessage = null;
    }

    private List<Donation> SortDonations(List<Donation> donations)
    {
        switch (sortBy)
        {
            case "Id":
                return sortDirection == SortOrder.Ascending ? donations.OrderBy(d => d.DonationID).ToList() : donations.OrderByDescending(d => d.DonationID).ToList();
            case "Name":
                return sortDirection == SortOrder.Ascending ? donations.OrderBy(d => d.Item).ToList() : donations.OrderByDescending(d => d.Item).ToList();
            case "Quantity":
                return sortDirection == SortOrder.Ascending ? donations.OrderBy(d => d.Quantity).ToList() : donations.OrderByDescending(d => d.Quantity).ToList();
            case "Date":
                return sortDirection == SortOrder.Ascending ? donations.OrderBy(d => d.Date).ToList() : donations.OrderByDescending(d => d.Date).ToList();
            case "Status":
                return sortDirection == SortOrder.Ascending ? donations.OrderBy(d => d.DonationStatus).ToList() : donations.OrderByDescending(d => d.DonationStatus).ToList();
            default:
                return donations;
        }
    }

    private void SortById()
    {
        SetSortDirection("Id");
    }

    private void SortByName()
    {
        SetSortDirection("Name");
    }

    private void SortByQuantity()
    {
        SetSortDirection("Quantity");
    }

    private void SortByDate()
    {
        SetSortDirection("Date");
    }

    private void SortByStatus()
    {
        SetSortDirection("Status");
    }

    private void SetSortDirection(string sortColumn)
    {
        if (sortBy == sortColumn)
        {
            sortDirection = sortDirection == SortOrder.Ascending ? SortOrder.Descending : SortOrder.Ascending;
        }
        else
        {
            sortBy = sortColumn;
            sortDirection = SortOrder.Ascending;
        }
    }

    private enum SortOrder
    {
        Ascending,
        Descending
    }
}