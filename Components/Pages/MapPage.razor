@page "/map"
@using IO.Modules.MapLibrary
@rendermode InteractiveServer

@inject GoogleMapsClient GoogleMaps;

<PageTitle>Map</PageTitle>

<h1>Map</h1>
<div id="map01" style="width: 100%; height: 500px;"></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GoogleMaps.InitializeApi("pl");
            
            MapController map01 = new(GoogleMaps, "map01");
            map01.Address = "Wólczańska 215C, 90-515 Łódź, Polska";
            await map01.DrawMap();
        }
    }
    
}