@page "/map"
@using IO.Modules.MapLibrary
@rendermode InteractiveServer
@inject GoogleMapsClient GoogleMaps;
@inject Geolocation Geolocation;
<PageTitle>Map</PageTitle>

<h1>Map</h1>
<div style="display: flex; gap: 20px; align-items: flex-start;">
    <div>
        <div style="display: flex; gap: 10px">
            <button class="btn btn-primary" @onclick="async () => { map01.SetLocation(_address); await map01.DrawMap(); }">Address</button>
            <button class="btn btn-primary" @onclick='async () => { map01.SetLocation("Warszawa"); await map01.DrawMap(); }'>String</button>
            <button class="btn btn-primary" @onclick="async () => { map01.SetLocation(await Geolocation.GetUserLocation()); await map01.DrawMap(); }">Coordinates</button>
            <button class="btn btn-primary" @onclick='async () => { Route rt = new Route(new CoordinatesWrapper(await Geolocation.GetUserLocation()), map01.GetLocation()); map01.SetRoute(rt); await map01.DrawMap(); }'>Route</button>
        </div>
        <div id="map01" style="width: 100%; height: 500px; margin-top: 20px;"></div>
    </div>
    @if (map01.GetRoute() != null)
    {
        <div style="display: flex; flex-direction: column-reverse; gap: 10px;">
            @for (var index = fieldValues.Count-1; index >= 0; index--)
            {
                Console.WriteLine(index);
                var i = index;
                <div id="textfield-container" style="display: flex; align-items: center; gap: 5px;">
                    <input class="form-control" type="text" @bind="fieldValues[i]" placeholder="Enter address or location" style="flex: 1;" />
                    <button class="btn btn-danger" @onclick="() => RemoveField(i)">-</button>
                </div>
            }
            <div style="display: flex; gap: 10px;">
                <button class="btn btn-success" @onclick="AddField">+</button>
                <button class="btn" style="background-color: #28a745; color: white;" @onclick="() => ConfirmFields()">
                    Add midpoints
                </button>
            </div>
        </div>
    }
</div>

@code {
    MapController map01;
    Address _address = new(
        "Łódź",
        "Wólczańska",
        "215C",
        "",
        "93-005"
    );

    int fieldCount = 1;
    private List<string> fieldValues = new List<string> { ""};

    protected override void OnInitialized()
    {
        map01 = new(GoogleMaps, "map01");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GoogleMaps.InitializeApi("pl");

            map01.SetLocation(_address);
            await map01.DrawMap();
        }
    }

    private void AddField()
    {
        fieldValues.Add("");
        fieldCount++;
    }

    private void RemoveField(int i)
    {
        if (fieldCount > 1)
        {
            fieldValues.RemoveAt(i);
            fieldCount--;
        }
    }
    private async void ConfirmFields()
    {
        Route rt = new Route(new CoordinatesWrapper(await Geolocation.GetUserLocation()), map01.GetLocation());
        foreach(string location in fieldValues)
        {
            if (!string.IsNullOrEmpty(location))
            {
                rt.AddRouteLocation(new AddressStringWrapper(location));
            }
        }
        map01.SetRoute(rt);
        await map01.DrawMap();
    }
}
