@page "/map"
@using IO.Modules.MapLibrary
@rendermode InteractiveServer

@inject GoogleMapsClient GoogleMaps;
@inject Geolocation Geolocation;

<PageTitle>Map</PageTitle>

<h1>Map</h1>

<div style="display: flex; gap: 10px">
    <button class="btn btn-primary" @onclick="async () => { map01.SetLocation(_address);
                                                            await map01.DrawMap(); }">Address</button>

    <button class="btn btn-primary" @onclick='async () => { map01.SetLocation("Warszawa");
                                                            await map01.DrawMap(); }'>String</button>

    <button class="btn btn-primary" @onclick="async () => { map01.SetLocation(await Geolocation.GetUserLocation());
                                                            await map01.DrawMap(); }">Coordinates</button>
    <button class="btn btn-primary" @onclick='async () => { Route rt = new Route(new CoordinatesWrapper(await Geolocation.GetUserLocation()), map01.GetLocation());
                                                            map01.SetRoute(rt);
                                                            map01.AddRouteLocation(new AddressStringWrapper("Płock"));
                                                            await map01.DrawMap();}'>Route</button>
</div>

<div id="map01" style="width: 100%; height: 500px;"></div>

@code {
    MapController map01;

    Address _address = new(
        "Łódź",
        "Wólczańska",
        "215C",
        "",
        "93-005"
    );
    //Route _route = new(new AddressStringWrapper("Łódź"), new AddressStringWrapper("Warszawa"));


    protected override void OnInitialized()
    {
        map01 = new(GoogleMaps, "map01");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GoogleMaps.InitializeApi("pl");
            
            map01.SetLocation(_address);
            await map01.DrawMap();
        }
    }
}