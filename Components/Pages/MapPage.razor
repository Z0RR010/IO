@page "/map"
@using IO.Modules.MapLibrary
@rendermode InteractiveServer

@inject GoogleMapsClient GoogleMaps;

<PageTitle>Map</PageTitle>

<h1>Map</h1>
<div id="map01" style="width: 100%; height: 500px;"></div>

@code {
    MapController map01;

    Address _address = new(
        "Łódź",
        "Wólczańska",
        "215C",
        "",
        "93-005"
    );
    
    protected override void OnInitialized()
    {
        map01 = new(GoogleMaps, "map01");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GoogleMaps.InitializeApi("pl");
            
            map01.Address = _address;
            await map01.DrawMap();
        }
    }
}