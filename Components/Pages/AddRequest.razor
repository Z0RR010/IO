@page "/requests/add"
@inject RequestModule.IRequestService RequestService

@code {
    private RequestModule.Request newRequest = new RequestModule.Request
        {
            Status = RequestModule.RequestStatus.New,
            Address = new RequestModule.Address() // Inicjalizacja Address
        };

    private void AddNewRequest()
    {
        newRequest = new RequestModule.Request
            {
                Status = RequestModule.RequestStatus.New,
                Address = new RequestModule.Address() // Inicjalizacja Address
            };
    }
}

<h3>Add Request</h3>

<EditForm Model="newRequest" OnValidSubmit="AddNewRequest">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="title">Title</label>
        <InputText id="title" class="form-control" @bind-Value="newRequest.Title" />
    </div>
    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="newRequest.Description" />
    </div>
    <div class="form-group">
        <label for="city">City</label>
        <InputText id="city" class="form-control" @bind-Value="newRequest.Address.City" />
    </div>
    <div class="form-group">
        <label for="state">Street</label>
        <InputText id="state" class="form-control" @bind-Value="newRequest.Address.Street" />
    </div>
    <div class="form-group">
        <label for="postalCode">Street Number</label>
        <InputText id="postalCode" class="form-control" @bind-Value="newRequest.Address.StreetNumber" />
    </div>
    <div class="form-group">
        <label for="country">Apartment</label>
        <InputText id="country" class="form-control" @bind-Value="newRequest.Address.Apartment" />
    </div>
    <div class="form-group">
        <label for="country">Zip code</label>
        <InputText id="country" class="form-control" @bind-Value="newRequest.Address.ZipCode" />
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>