@page "/requests/add"
@rendermode InteractiveServer
@inject IO.Modules.Security.SessionService sessionService
@using IO.Modules.Security

<h3>Add Request</h3>
    <div class="form-group">
        <label for="title">Title</label>
        <InputText id="title" class="form-control" @bind-Value="newRequest.Title" />
    </div>
    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="newRequest.Description" />
    </div>
    <div class="form-group">
        <label for="city">City</label>
        <InputText id="city" class="form-control" @bind-Value="newRequest.Address.City" />
    </div>
    <div class="form-group">
        <label for="street">Street</label>
        <InputText id="street" class="form-control" @bind-Value="newRequest.Address.Street" />
    </div>
    <div class="form-group">
        <label for="streetNumber">Street Number</label>
        <InputText id="streetNumber" class="form-control" @bind-Value="newRequest.Address.StreetNumber" />
    </div>
    <div class="form-group">
        <label for="apartment">Apartment</label>
        <InputText id="apartment" class="form-control" @bind-Value="newRequest.Address.Apartment" />
    </div>
    <div class="form-group">
        <label for="zipCode">Zip Code</label>
        <InputText id="zipCode" class="form-control" @bind-Value="newRequest.Address.ZipCode" />
    </div>
    <button type="submit" class="btn btn-primary" @onclick="HandleValidSubmit">Submit</button>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

@code {

    private IO.Modules.ResourceManager.UserExecuter userExecuter = new IO.Modules.ResourceManager.UserExecuter();

    private string email;
    private String token;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        email = await sessionService.GetUserNameAsync();
        token = userExecuter.GetToken(email);
    }

    private RequestModule.Request newRequest = new RequestModule.Request
    {
            Status = RequestModule.RequestStatus.New,
            Address = new RequestModule.Address(), // Inicjalizacja Address
            User = "test"
    };

    private string? message;

    private IO.Modules.ResourceManager.RequestManager requestManager = new IO.Modules.ResourceManager.RequestManager();

    private List<IO.Modules.ResourceManager.Resource> selectedResources;

    private async Task HandleValidSubmit()
    {

        try
        {
            newRequest.IsVerified = false;
            newRequest.CreatedAt = DateTime.Now;
            newRequest.DateUpdated = DateTime.Now;
            // Dodanie do bazy danych
            bool isAdded = requestManager.AddRequestToDatabase(newRequest);

            if (isAdded)
            {
                message = "Request successfully added!";
                ResetForm();
            }
            else
            {
                message = "Failed to add request. Please try again.";
            }
        }
        catch (Exception ex)
        {
            message = $"An error occurred: {ex.Message}";
        }
    }

    private void ResetForm()
    {
        newRequest = new RequestModule.Request
            {
                Status = RequestModule.RequestStatus.New,
                Address = new RequestModule.Address() // Inicjalizacja Address
            };
    }
}
