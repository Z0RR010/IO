@page "/signIn"
@inject IStringLocalizer<SignIn> Loc
@inject NavigationManager nav

@using System.Text.Json  
@using System.Text
@using IO.Modules.Security
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.Extensions.Localization
@using System.Text.RegularExpressions
@inject AppDbContext appDbContext

<div class="row">
    <div class="col-lg-4 offset-lg-4 pt-4 pb-4 border">
        <EditForm Model="@Model" OnValidSubmit="Authenticate" FormName="LoginForm">
            <DataAnnotationsValidator/>
            <div class="mb-3 text-center flex-column">
                <h3>@Loc["Login"]</h3>
            </div>
            <div class="mb-3">
                <label>Email</label>
                <InputText @bind-Value="Model.Email" class="form-control" placeholder="Email"/>
                <ValidationMessage For="() => Model.Email"/>
            </div>
            <div class="mb-3">
                <label>Password</label>
                <InputText @bind-Value="Model.Password" class="form-control" placeholder="Password" type="password"/>
                <ValidationMessage For="() => Model.Password" />
            </div>
            <div class="mb-3 text-center">
                <span class="text-danger">@errorMessage</span>
            </div>
            <div class="mb-3 d-grid gap-2">
                <button type="submit" class="btn btn-primary">Login</button>
            </div>
        </EditForm>
    </div>
</div>

<footer class="footer">
    <button class="lang" onclick="location.href='@GetCultureUrl("pl")'">Polski</button>
    <button class="lang" onclick="location.href='@GetCultureUrl("en-US")'">English</button>
</footer>

@code {
    private string username;
    private string password;
    private string errorMessage;
    private bool success = false;

    [SupplyParameterFromForm]
    public LoginViewModel Model { get; set; } = new();

    [CascadingParameter]
    public HttpContext? HttpContext{ get; set; }

    private string GetCultureUrl(string culture)
    {
        var currentUri = nav.Uri;

        if (currentUri.Contains("?ui-culture="))
        {
            currentUri = currentUri.Replace(Regex.Match(currentUri, @"\?ui-culture=[^&]+").Value, $"?ui-culture={culture}");
        }
        else
        {
            currentUri += $"?ui-culture={culture}";
        }

        return currentUri;
    }

    private async Task HandleSignIn()
    {
        if (username != null || password != null)
        {
            using (var client = new HttpClient())
            {
                var loginRequest = new LoginRequest() { Username = username, Password = Security.hashData(password) };

                try
                {
                    Console.WriteLine($"Zawartość loginRequest: Username={loginRequest.Username}, Password={loginRequest.Password}");
                    var response = await client.PostAsJsonAsync(nav.BaseUri + "api/SignIn/SignIn", loginRequest);
                    Console.WriteLine(response.StatusCode);
                    if (response.IsSuccessStatusCode)
                    {
                        success = true;
                        errorMessage = "Poprawnie zalogowano.";

                        var claims = new List<Claim>
                        {
                            new Claim(ClaimTypes.Name, username),
                            new Claim(ClaimTypes.Role, "user")
                        };

                        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
                        var principal = new ClaimsPrincipal(identity);

                        await HttpContext.SignInAsync(principal);
                        nav.NavigateTo("/");
                    }
                    else
                    {
                        success = false;
                        errorMessage = "Nieprawidłowe dane logowania.";
                    }
                }
                catch (Exception ex)
                {
                    errorMessage = "Wystąpił błąd podczas logowania.";
                }
            }
        }
    }

    private async Task Authenticate()
    {
        var userAccount = appDbContext.UserAccounts.Where(x => x.Email == Model.Email).FirstOrDefault();
        var hashedPassword = Security.hashData(Model.Password);
        using (var client = new HttpClient())
        {
            var loginRequest = new LoginRequest() { Username = userAccount.Email, Password = hashedPassword };
            var response = await client.PostAsJsonAsync(nav.BaseUri + "api/SignIn/SignIn", loginRequest);
            var responseContent = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                try
                {
                    var errorResponse = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(responseContent);

                    errorMessage = errorResponse != null && errorResponse.ContainsKey("message")
                    ? errorResponse["message"]
                    : "Wystąpił błąd podczas logowania.";
                    if (errorMessage.Contains("Zbyt")) {
                        var emailDto = new EmailDto() { To = "skph@interia.pl", Subject = "Wielokrotna nieudana próba zalogowania", Body = $@"
				        <p>Użytkownik {userAccount.Email} przekroczył limit nieudanych prób logowania.</p>" };

                        try
                        {
                            response = await client.PostAsJsonAsync(nav.BaseUri + "api/Email/SendEmail", emailDto);
                            Console.WriteLine(response.StatusCode);
                        }
                        catch (Exception ex)
                        {
                        }
                    }
                }
                catch
                {
                    errorMessage = "Wystąpił błąd podczas logowania: " + responseContent;
                }
                return;
            }
        }
        if(userAccount is null || userAccount.Password != hashedPassword)
        {
            errorMessage = "Podano niepoprawne dane";
            return;
        }
        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.Name, Model.Email),
            new Claim(ClaimTypes.Role, userAccount.Role)
        };

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await HttpContext.SignInAsync(principal);
        nav.NavigateTo("/");
    }

    private async Task English()
    {
        String newUri = nav.Uri;
        String oldUri = nav.Uri;
        if (newUri.Contains("?ui-culture=pl"))
        {
            newUri = newUri.Replace("?ui-culture=pl", "?ui-culture=en-US");
        }
        if (!newUri.Contains("?ui-culture=en-US"))
        {
            newUri += "?ui-culture=en-US";
        }
        nav.NavigateTo(newUri,true);
    }

    private async Task Polish()
    {
        String newUri = nav.Uri;
        if (newUri.Contains("?ui-culture=en-US"))
        {
            newUri = newUri.Replace("?ui-culture=en-US", "?ui-culture=pl");
        }
        if (!newUri.Contains("?ui-culture=pl"))
        {
            newUri += "?ui-culture=pl";
        }
        nav.NavigateTo(newUri,true);
    }
}