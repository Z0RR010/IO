@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div>Polski</div>
            <div class="lang">English</div>
            <div class="nav-item px-3">
            <NavLink class="nav-link" href="signIn">Sign In
            </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="signUp">Sign Up
                </NavLink>
            </div>
