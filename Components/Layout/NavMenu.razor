@rendermode InteractiveServer
@using IO.Modules.Security
@using IO.Modules.Volunteer
@using IO.Modules.ResourceManager;
@using RequestModule;
@using Microsoft.Extensions.Localization
@inject SessionService sessionService
@inject IStringLocalizer<NavMenu> Loc

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">IO</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Loc["Home"]
            </NavLink>
        </div>
        @if (userType == "Volunteer" || userType == "Charity" || userType == "Affected" || userType == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="volunteerPage">
                <span class="bi bi-person-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Volunteer"]
            </NavLink>
            </div>
        }
        @if (userType == "Charity" || userType == "Donor" || userType == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="donorPage">
                <span class="bi bi-person-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Donor"]
            </NavLink>
            </div>
        }
        @if (userType == "Charity" || userType == "Authority" || userType == "Affected" || userType == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="requests">
                <span class="bi bi-person-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Requests"]
            </NavLink>
            </div>
        }
        @if ((userType == "Affected" && isVerified) || userType == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="requests/add">
                <span class="bi bi-person-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Add Requests"]
            </NavLink>
            </div>
        }
        @if (userType == "Admin")
        {
            <div class="nav-item px-3">
            <NavLink class="nav-link" href="map">
                <span class="bi bi-pin-map-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Map Test"]
            </NavLink>
        </div>
        }
        
        @if (userType == "Authority" || userType == "Admin" || userType == "Charity")
        {
            <div class="nav-item px-3">
            <NavLink class="nav-link" href="resources">
                @Loc["View resources"]
            </NavLink>
        </div>
        }
        
        @if (userType == "Admin")
        {
            <div class="nav-item px-3">
            <NavLink class="nav-link" href="communication">
                <span class="bi bi-plus-square-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Communication"]
            </NavLink>
        </div>
        }
        @if (mail != "Anonymous")
        {
            <div class="nav-item px-3">
            <NavLink class="nav-link" href="communication/conversation">
                    <span class="bi bi-plus-square-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Conversation"]
            </NavLink>
        </div>
        }
        
        @if (userType == "Authority" || userType == "Admin")
        {
            <div class="nav-item px-3">
            <NavLink class="nav-link" href="verification">
                    <span class="bi bi-plus-square-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Verification"]
            </NavLink>
        </div>
        }
        @if (userType == "Authority" || userType == "Admin" || userType == "Charity")
        {
            <div class="nav-item px-3">
            <NavLink class="nav-link" href="/Communication/Reports">
                    <span class="bi bi-plus-square-fill" style="font-size: 1.5rem; margin-top: -25px;" aria-hidden="true"></span> @Loc["Reports"]
            </NavLink>
        </div>
        }
        
  

    </nav>
</div>

@code{
    string userType = string.Empty;
    bool isVerified = false;
    string mail = string.Empty;
    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        mail= await sessionService.GetUserNameAsync();
        UserExecuter userExecuter = new UserExecuter();
        BasicUser basicUser = userExecuter.GetBasicUser(mail);

        if (basicUser != null)
        {
            userType = basicUser.Role;
            isVerified = basicUser.IsVerified;
        }
    }
}